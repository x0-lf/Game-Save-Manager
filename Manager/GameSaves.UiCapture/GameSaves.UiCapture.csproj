<Project Sdk="Microsoft.NET.Sdk">

  <!-- Development-only screenshot harness for the UI revamp visual review
       loop, and since the gallery work the home of the shared gallery plan,
       showcase fixture, and capture isolation. Never published and never
       shipped. Referenced by GameSaves.Tests, which asserts the plan, and its
       Gallery folder is linked into GameSaves.UiMaterialCapture so one
       scenario means the same thing in both harnesses.
       See docs/development.md, "Gallery capture". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameSaves.App\GameSaves.App.csproj" />
  </ItemGroup>

</Project>
