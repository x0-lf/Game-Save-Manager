<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:w="using:GameSaves.App.Views.Workspace">

    <!-- The workspace panel is the app's existing card, given a header that
         doubles as a drag handle. At rest it must look exactly like the card
         it replaced: same surface, same 1px edge, same 14px radius, same
         padding. The two layout affordances (collapse chevron, panel menu)
         stay at zero opacity until the pointer enters the panel or keyboard
         focus lands inside it, so a page of six cards is not a page of twelve
         extra buttons. -->

    <ControlTheme x:Key="{x:Type w:WorkspacePanel}" TargetType="w:WorkspacePanel">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Card"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid RowDefinitions="Auto,*">

                        <!-- Header. The whole strip is the drag handle; the
                             buttons inside it keep their own clicks. -->
                        <Grid x:Name="PART_Header"
                              Grid.Row="0"
                              Background="Transparent"
                              ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                              MinHeight="30"
                              Margin="14,10,10,0">

                            <TextBlock x:Name="PART_Glyph"
                                       Grid.Column="0"
                                       Text="{TemplateBinding Glyph}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="20"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       IsVisible="{Binding Glyph, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="PART_Title"
                                           Text="{TemplateBinding Title}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock x:Name="PART_Subtitle"
                                           Text="{TemplateBinding Subtitle}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextWrapping="Wrap"
                                           MaxWidth="760"
                                           HorizontalAlignment="Left"
                                           IsVisible="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <ContentPresenter Grid.Column="2"
                                              Margin="8,0,0,0"
                                              Content="{TemplateBinding HeaderActions}"
                                              VerticalAlignment="Center" />

                            <ToggleButton x:Name="PART_CollapseButton"
                                          Grid.Column="3"
                                          Classes="panelChrome"
                                          IsChecked="{Binding IsCollapsed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          IsVisible="{TemplateBinding CanCollapse}"
                                          AutomationProperties.Name="Collapse or expand this section"
                                          ToolTip.Tip="Collapse or expand this section">
                                <TextBlock Text="&#xE70D;" Classes="panelChromeGlyph" />
                            </ToggleButton>
                            <Button x:Name="PART_MenuButton"
                                    Grid.Column="4"
                                    Classes="panelChrome"
                                    AutomationProperties.Name="Section layout menu"
                                    ToolTip.Tip="Move, collapse, float or hide this section">
                                <TextBlock Text="&#xE712;" Classes="panelChromeGlyph" />
                            </Button>
                        </Grid>

                        <Border x:Name="PART_HeaderRule"
                                Grid.Row="0"
                                VerticalAlignment="Bottom"
                                Height="1"
                                IsVisible="False"
                                Background="{DynamicResource CardBorderBrush}" />

                        <ContentPresenter x:Name="PART_Content"
                                          Grid.Row="1"
                                          Margin="14,10,14,14"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Layout affordances. Both buttons keep the app's 24px icon-button
             anatomy and stay in the tab order at all times; only their paint
             is withheld until the panel is approached, so nothing a keyboard
             user can reach is ever invisible to them. -->
        <Style Selector="^ /template/ Button#PART_MenuButton">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^ /template/ ToggleButton#PART_CollapseButton">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:pointerover /template/ Button#PART_MenuButton">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:pointerover /template/ ToggleButton#PART_CollapseButton">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:focus-within /template/ Button#PART_MenuButton">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:focus-within /template/ ToggleButton#PART_CollapseButton">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- A collapsed panel keeps its chevron visible: the only cue that
             content is folded away must not require a hover to find. -->
        <Style Selector="^:collapsed /template/ ToggleButton#PART_CollapseButton">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- A banner-style panel carries no body at all; without this the
             presenter still measures its own margin and leaves a band of dead
             space under the text. Expressed as a pseudo-class rather than a
             template binding so the collapsed rule below can still win. -->
        <Style Selector="^:bodyless /template/ ContentPresenter#PART_Content">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- With no body, the header owns the cards bottom padding too. -->
        <Style Selector="^:bodyless /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="14,10,10,10" />
        </Style>

        <!-- Collapsed: the header alone, with the card closing up under it. -->
        <Style Selector="^:collapsed /template/ ContentPresenter#PART_Content">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:collapsed /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="14,10,10,10" />
        </Style>
        <Style Selector="^:collapsed /template/ ToggleButton#PART_CollapseButton TextBlock">
            <Setter Property="Text" Value="&#xE70E;" />
        </Style>

        <!-- The quiet header idiom: the dashboard's stat cards label
             themselves in muted small text rather than as section headings,
             and must keep doing so. -->
        <Style Selector="^.quiet /template/ TextBlock#PART_Title">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="^.quiet /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="18,16,10,0" />
        </Style>
        <Style Selector="^.quiet /template/ ContentPresenter#PART_Content">
            <Setter Property="Margin" Value="18,6,18,18" />
        </Style>

        <!-- The page-header idiom: the card at the top of every page states the
             page's name at h1 weight. Same treatment as TextBlock.h1, so the
             heading does not shrink when the card becomes a panel. -->
        <Style Selector="^.pageHeader /template/ TextBlock#PART_Title">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeH1}" />
        </Style>
        <Style Selector="^.pageHeader /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="16,10,10,0" />
        </Style>
        <Style Selector="^.pageHeader /template/ ContentPresenter#PART_Content">
            <Setter Property="Margin" Value="16,2,16,10" />
        </Style>

        <!-- The warning idiom: a tinted band rather than a card, for the one
             condition that makes the whole app inert. Keeps the warning
             surface, edge and ink the banner already had. -->
        <Style Selector="^.warning">
            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningEdgeBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="^.warning /template/ TextBlock#PART_Glyph">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="^.warning /template/ TextBlock#PART_Subtitle">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style Selector="^.table /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="14,10,10,10" />
        </Style>
        <Style Selector="^.table /template/ Border#PART_HeaderRule">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- The table idiom: a panel whose body is a table takes no horizontal
             content inset, so the column-header rule and every row separator
             run to the card edge the way they did when the card was a Border
             with Padding="0". A rule that stops 14px short of both edges reads
             as unfinished. The rows carry their own horizontal padding. -->
        <Style Selector="^.table /template/ ContentPresenter#PART_Content">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- The panel being dragged fades so the preview behind it reads. -->
        <Style Selector="^:dragging /template/ Border#PART_Card">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
