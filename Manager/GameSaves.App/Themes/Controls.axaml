<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Popup navigation must not inherit a transparent page behind its text. -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter, ToolTip">
        <Setter Property="Background" Value="{DynamicResource NavigationSurfaceBrush}" />
    </Style>

    <!-- Button hierarchy. Default Fluent buttons are the secondary tier;
         "primary" marks the one safe, non-destructive headline action per surface;
         "danger" marks destructive actions with an outline treatment so it
         warns without shouting. All colours come from the token dictionary,
         so both themes and any future accent theme get these for free. -->

    <!-- Secondary (default) buttons: bordered ghost on the card surface,
         so enabled state has a visible edge and disabled state is
         unmistakably faded rather than another identical grey slab. -->
    <!-- One control height for the whole product. Every button, text input
         and select is 32 px; the only exceptions are the 24 px square icon
         buttons (their own hit-target rule) and the navigation rail's own
         item height. Views must not set Height on these controls. -->
    <Style Selector="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InsetBackgroundBrush}" />
    </Style>
    <!-- Disabled tiers: buttons keep their anatomy (border, height, radius)
         with muted-but-legible labels; a disabled primary drops its accent
         fill entirely so it can never read as enabled in either theme. -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <!-- The control-border role, muted by the 0.6 disabled opacity below
             rather than by a weaker colour: a disabled button must still read
             as a button next to its enabled sibling. -->
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="TextBox:disabled">
        <Setter Property="Background" Value="{DynamicResource InsetBackgroundBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Background" Value="{DynamicResource InsetBackgroundBrush}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="CheckBox:checked:disabled">
        <Setter Property="Opacity" Value="0.95" />
    </Style>
    <!-- Slider was the one interactive control with no disabled treatment. The
         transparency sliders are disabled whenever a window material is
         selected or high contrast is on — both routine — so a disabled slider
         that still read as a live accent bar would be a standing lie about
         what the control does. -->
    <Style Selector="Slider:disabled">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="RadioButton:disabled">
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="RadioButton:checked:disabled">
        <Setter Property="Opacity" Value="0.95" />
    </Style>

    <!-- Inputs are inset-filled so they can never be mistaken for the
         ghost-outline buttons, including when a button is disabled. -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderInkBrush}" />
    </Style>

    <!-- Scrollbars: slim, inset from card edges, rounded thumb, so a
         resting scrollbar reads as a designed element instead of a stray
         hairline crossing rounded corners. -->
    <!-- One page-title treatment for every view. -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="12" />
        <Setter Property="Margin" Value="0,6,3,6" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="6,0,6,3" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- An expanded bar is 16 px of track; the thumb inside it is 8 px so the
         track still reads as a track. Fluent's resting form is a 2 px
         hairline, which is not a drag target, so every bar that must be
         usable at rest sets AllowAutoHide="False". -->
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="Width" Value="8" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb">
        <Setter Property="Height" Value="8" />
    </Style>
    <!-- Every scrollbar rests expanded and visible. Fluent's resting form
         is a 2 px hairline that is neither a drag target nor a legible cue
         that content continues; AllowAutoHide="False" is the supported way
         to keep the expanded form. Duration still comes from a resource so
         the accessibility Reduce Motion setting can swap any opacity
         transition for an instant change. -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Transitions" Value="{DynamicResource ScrollBarOpacityTransitions}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CardBackgroundBrush}" />
    </Style>

    <!-- Detach button on each navigation tab header: floats the section in
         its own window; closing the window reattaches the tab. The button is
         keyboard focusable; its hit target meets the 24x24 minimum by growing
         leftward over the label-to-button gap (negative margin) with
         asymmetric padding, so the glyph keeps its exact pixel position and
         the rail width does not change. -->
    <Style Selector="Button.navDetach">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6,4,6" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="-4,0,0,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.navDetach TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Button.navDetach:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!-- Other icon-only buttons (header gear). Base chrome lives in a class
         style rather than inline on the button so the :focus-visible state
         below can rebalance padding without losing to local values. -->
    <Style Selector="Button.iconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Keyboard focus rings for the small icon-only controls. Only the
         :focus-visible pseudo-class is styled, so mouse users never see these
         visuals. The border is compensated by padding reduced by the same 2px
         on every edge, which keeps the box size and the glyph position
         pixel-identical while the accent ring is showing. -->
    <Style Selector="Button.navDetach:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="6,4,2,4" />
    </Style>
    <Style Selector="Button.iconButton:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- Workspace panel chrome: the collapse chevron and the panel menu. Same
         anatomy as the header gear (24px square, transparent, 4px radius,
         muted glyph), so the layout affordances read as part of the product
         rather than as an IDE toolbar bolted on. The focus ring rebalances
         padding by the border width, keeping the glyph pixel-stable. -->
    <Style Selector="Button.panelChrome, ToggleButton.panelChrome">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.panelChromeGlyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.panelChrome:pointerover TextBlock.panelChromeGlyph">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.panelChrome:pointerover TextBlock.panelChromeGlyph">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.panelChrome:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="ToggleButton.panelChrome:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!-- Navigation-rail chrome: the collapse toggle and the Scan action. Same
         anatomy as the rail's own entries (32px tall, 8px radius, muted glyph)
         so they read as part of the rail rather than as floating buttons, and
         the same accent focus ring as every other icon control. -->
    <Style Selector="Button.railChrome, ToggleButton.railChrome">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock.railChromeGlyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The Scan action is the app's one recurring primary verb, so it carries
         the accent wherever it appears. -->
    <Style Selector="TextBlock.railAccentGlyph">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.railChromeLabel">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.railChrome:pointerover, ToggleButton.railChrome:pointerover">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    </Style>
    <Style Selector="Button.railChrome:focus-visible, ToggleButton.railChrome:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!-- The docking guide. The targets are cards, the preview is an accent
         wash: both are the app's own surfaces, so the guide reads as this
         product's own affordance and follows the chosen accent. -->
    <Style Selector="Border.dockTarget">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #33000000" />
    </Style>
    <Style Selector="Border.dockTarget.active">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.dockTarget TextBlock.dockTargetGlyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="Border.dockTarget.active TextBlock.dockTargetGlyph">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Border.dockPreview">
        <Setter Property="Background" Value="{DynamicResource AccentPreviewTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <!-- Page-level scroll surfaces: unlike transient inner scrollbars, the
         page scrollbar rests visible so content below the 800x600 fold has
         a discoverable cue. Rest visibility comes from real thumb ink at
         full opacity — a fractional Opacity over the collapsed hairline
         thumb measured as near-invisible (critic round 31). -->
    <Style Selector="ScrollViewer.pageScroll /template/ ScrollBar:vertical">
        <Setter Property="Margin" Value="0,6,0,6" />
    </Style>
    <Style Selector="ScrollViewer.pageScroll /template/ ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <!-- DataGrid: the table belongs to the card it sits in. The header is a
         quiet inset band, gridlines are subtle, hover uses the app's inset
         hover idiom, and selection is an accent tint rather than a slab.
         Ordering matters within the row-state block: selected must follow
         pointerover, and selected:pointerover must come last, because style
         collection order decides which matching setter wins. -->
    <Style Selector="DataGrid /template/ ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="DataGrid">
        <!-- The table owns its own scrollbars; the attached property is the
             only handle on them, because the DataGrid template sets
             AllowAutoHide locally and a local value beats a style. -->
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource InsetBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="AreSeparatorsVisible" Value="True" />
    </Style>
    <Style Selector="DataGridColumnHeader /template/ Path#SortIcon">
        <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="DataGridRow /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource InsetBackgroundBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Opacity" Value="0.18" />
    </Style>

    <!-- List selection uses the same accent tint as a selected table row.
         Fluent's own ListBoxItem selection is a 40-90% accent slab, which is a
         different idiom from this app's tables and reads as a second design
         system inside the same window. The keys are set inline in Fluent's
         control theme, so the states are restated here rather than retargeted
         through a resource. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Opacity" Value="0.18" />
    </Style>

    <!-- Keyboard focus on the text inputs and selects. The resting BorderBrush
         setters above are unconditional Styles, which outrank Fluent's own
         focused-border setter in its ControlTheme, so without these two rules
         a focused TextBox or ComboBox shows no ring at all. -->
    <Style Selector="TextBox:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- The keyboard focus ring follows the accent everywhere, not only on the
         handful of icon-button classes that got one by hand. Fluent draws the
         ring as a two-tone outline: an outer stroke that must read against the
         page and an inner stroke that must read against the control's own fill.
         Only the OUTER stroke takes the accent — putting the accent on both
         would make the ring vanish on an accent-filled primary button, which is
         exactly why Fluent's own default is neutral. The inner stroke keeps its
         contrasting neutral, so the ring stays visible on every surface. -->
    <Style Selector=":is(Control)">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Margin="-2" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- The Transfer profiles copy gate. Its checked state is a tinted band
         that has to follow the accent like every other selection fill; the
         fixed inset token left an armed gate looking identical to an unarmed
         one. The rules live here, not in the view, because the panel that
         carries the gate can be floated into its own window, where a
         UserControl's own Styles no longer reach it. -->
    <Style Selector="Border.confirmGate">
        <Setter Property="Background" Value="{DynamicResource InsetBackgroundBrush}" />
    </Style>
    <Style Selector="Border.confirmGate.armed">
        <Setter Property="Background" Value="{DynamicResource AccentSelectionTintBrush}" />
    </Style>

    <!-- The drag handle between two docked workspace panels. At rest it is the
         page's ordinary gutter, so a page still reads as cards separated by
         space rather than as a grid of rules. Pointing at it paints the app's
         splitter colour, which is what makes the handle discoverable without
         putting permanent furniture between every pair of sections; keyboard
         focus uses the accent, matching every other focus ring here. The
         workspace surface sets the matching resize cursor. -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
    </Style>
    <Style Selector="GridSplitter:focus-visible">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

</Styles>
