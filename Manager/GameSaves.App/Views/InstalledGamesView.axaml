<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             x:Class="GameSaves.App.Views.InstalledGamesView"
             x:DataType="vm:InstalledGamesViewModel"
             Background="{DynamicResource PageBackgroundBrush}">

    <UserControl.Styles>
        <Style Selector="DataGrid.installedGamesTable /template/ ScrollBar:horizontal">
            <Setter Property="Opacity" Value="0.2" />
        </Style>
        <Style Selector="DataGrid.installedGamesTable:pointerover /template/ ScrollBar:horizontal">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          RowSpacing="10"
          Margin="0,12,0,14"
          MaxWidth="1100">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10">

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <StackPanel Grid.Column="0"
                            Spacing="2">
                    <TextBlock Text="Installed games" Classes="h1" />

                    <TextBlock Text="Discovered games and whether their saves are mapped."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Scan Steam library"
                        IsVisible="{Binding !!Games.Count}"
                        Command="{Binding RefreshCommand}"
                        Height="34"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- DataGrid owns one shared column measure for headers and every row.
             Headers can be reordered/resized; visibility and order persist. -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="4">

            <Grid>

            <DataGrid x:Name="GamesGrid"
                      Classes="installedGamesTable"
                      ItemsSource="{Binding Games}"
                      SelectedItem="{Binding SelectedGame}"
                      IsVisible="{Binding !!Games.Count}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Visible"
                      VerticalScrollBarVisibility="Auto"
                      RowHeight="44"
                      Background="Transparent"
                      BorderThickness="0"
                      ColumnReordered="OnColumnReordered">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Game"
                                            Tag="game"
                                            Width="200"
                                            SortMemberPath="GameName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                <TextBlock Text="{Binding GameName}"
                                           ToolTip.Tip="{Binding GameName}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="AppID"
                                        Tag="appId"
                                        Binding="{Binding AppId}"
                                        Width="80"
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        FontSize="12" />

                    <DataGridTemplateColumn Header="Install path"
                                            Tag="installPath"
                                            Width="240"
                                            SortMemberPath="InstallPath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                <TextBlock Text="{Binding InstallPath}"
                                           ToolTip.Tip="{Binding InstallPath}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Library"
                                            Tag="library"
                                            Width="200"
                                            SortMemberPath="LibraryPath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                <TextBlock Text="{Binding LibraryPath}"
                                           ToolTip.Tip="{Binding LibraryPath}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Approved"
                                        Tag="approved"
                                        Binding="{Binding ApprovedMappings}"
                                        Width="105"
                                        Foreground="{DynamicResource SuccessBrush}"
                                        FontSize="12" />

                    <DataGridTextColumn Header="Pending"
                                        Tag="pending"
                                        Binding="{Binding PendingMappings}"
                                        Width="95"
                                        Foreground="{DynamicResource WarningBrush}"
                                        FontSize="12" />

                    <DataGridTextColumn Header="Needs fix"
                                        Tag="needsFix"
                                        Binding="{Binding NeedsFixMappings}"
                                        Width="105"
                                        Foreground="{DynamicResource DangerBrush}"
                                        FontSize="12" />

                    <DataGridTextColumn Header="Exists"
                                        Tag="exists"
                                        Binding="{Binding SavePathExists}"
                                        Width="85"
                                        Foreground="{DynamicResource AccentBrush}"
                                        FontSize="12" />

                    <DataGridTemplateColumn Header="Files"
                                            Tag="files"
                                            Width="100"
                                            SortMemberPath="FileCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileCount}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding TotalSizeDisplay}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Status"
                                        Tag="status"
                                        Binding="{Binding Status}"
                                        Width="160"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state: shown only when there are no games and no load is
                 in progress (avoids flashing during the startup scan). -->
            <views:EmptyState Glyph="&#xE8FD;"
                              Title="No games found"
                              Message="Scan your Steam libraries to see installed games and their save status.">
                <views:EmptyState.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!Games.Count" />
                        <Binding Path="!IsLoading" />
                    </MultiBinding>
                </views:EmptyState.IsVisible>
                <views:EmptyState.ActionContent>
                    <Button Content="Scan Steam library"
                            Classes="primary"
                            Command="{Binding RefreshCommand}" />
                </views:EmptyState.ActionContent>
            </views:EmptyState>
            </Grid>
        </Border>
    </Grid>
</UserControl>
