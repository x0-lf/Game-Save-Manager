<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             x:Class="GameSaves.App.Views.InstalledGamesView"
             x:DataType="vm:InstalledGamesViewModel"
             Background="{DynamicResource PageBackgroundBrush}">


    <Grid RowDefinitions="Auto,*"
          RowSpacing="10"
          Margin="0,12,0,14"
          MaxWidth="1100">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10">

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <StackPanel Grid.Column="0"
                            Spacing="2">
                    <TextBlock Text="Installed games" Classes="h1" />

                    <TextBlock Text="Discovered games and whether their saves are mapped."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Scan Steam library"
                        IsVisible="{Binding !!Games.Count}"
                        Command="{Binding RefreshCommand}"
                        Height="34"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Games table: scrolls horizontally as one unit so columns never
             get crushed; rows scroll vertically inside. -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="4">

            <Grid>

            <!-- Table (headers + rows + scroll chrome) hides as one unit when
                 there are no games, so no orphaned headers or scrollbar. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          IsVisible="{Binding !!Games.Count}">

                <Grid RowDefinitions="Auto,*"
                      MinWidth="820">

                    <Border Grid.Row="0"
                            Padding="10,8"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1">

                        <Grid ColumnDefinitions="2*,60,2*,90,62,56,62,48,66,90"
                              ColumnSpacing="8">

                            <TextBlock Grid.Column="0" Text="Game" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="AppID" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="Install path" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="3" Text="Library" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="4" Text="Approved" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="5" Text="Pending" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="6" Text="Needs fix" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="7" Text="Exists" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="8" Text="Files" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <TextBlock Grid.Column="9" Text="Status" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                    <Border Padding="10,7"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1">

                                        <Grid ColumnDefinitions="2*,60,2*,90,62,56,62,48,66,90"
                                              ColumnSpacing="8">

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding GameName}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       ToolTip.Tip="{Binding GameName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AppId}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding InstallPath}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       ToolTip.Tip="{Binding InstallPath}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding LibraryPath}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       ToolTip.Tip="{Binding LibraryPath}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding ApprovedMappings}"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding PendingMappings}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding NeedsFixMappings}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="7"
                                                       Text="{Binding SavePathExists}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileCount}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="12" />

                                                <TextBlock Text="{Binding TotalSizeDisplay}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="10" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="9"
                                                       Text="{Binding Status}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ScrollViewer>

            <!-- Empty state: shown only when there are no games and no load is
                 in progress (avoids flashing during the startup scan). -->
            <views:EmptyState Glyph="&#xE8FD;"
                              Title="No games found"
                              Message="Scan your Steam libraries to see installed games and their save status.">
                <views:EmptyState.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!Games.Count" />
                        <Binding Path="!IsLoading" />
                    </MultiBinding>
                </views:EmptyState.IsVisible>
                <views:EmptyState.ActionContent>
                    <Button Content="Scan Steam library"
                            Classes="primary"
                            Command="{Binding RefreshCommand}" />
                </views:EmptyState.ActionContent>
            </views:EmptyState>
            </Grid>
        </Border>
    </Grid>
</UserControl>
