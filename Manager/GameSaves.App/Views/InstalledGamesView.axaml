<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             xmlns:wsp="using:GameSaves.App.Views.Workspace"
             x:Class="GameSaves.App.Views.InstalledGamesView"
             x:DataType="vm:InstalledGamesViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="DataGrid.installedGamesTable /template/ ScrollBar:horizontal">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGrid.installedGamesTable /template/ ScrollBar:horizontal /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="DataGrid.installedGamesTable:pointerover /template/ ScrollBar:horizontal">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="TextBlock.countApproved">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.countPending">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.countNeedsFix">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.zero">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.statusCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="TextBlock.statusCell.healthy">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.statusCell.caution">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.statusCell.blocked">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>

    <wsp:WorkspaceSurface Layout="{Binding Workspace}"
                          MaxWidth="1100"
                          Margin="0,12,24,14">
        <wsp:WorkspaceSurface.Panels>

            <wsp:WorkspacePanel PanelKey="installedGames.header"
                                Classes="pageHeader"
                                Title="Installed games"
                                Subtitle="Discovered games and whether their saves are mapped."
                                CanHide="False"
                                MinPanelWidth="320">
                <wsp:WorkspacePanel.HeaderActions>
                    <!-- Settings can drop the Scan action from this page; the rail
                         action always remains, so scanning is never unreachable. -->
                    <Panel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.ShowScanOnInstalledGames}">
                        <Button Content="Scan Steam library"
                                IsVisible="{Binding !!Games.Count}"
                                Command="{Binding RefreshCommand}"
                                VerticalAlignment="Center" />
                    </Panel>
                </wsp:WorkspacePanel.HeaderActions>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextWrapping="Wrap" />
            </wsp:WorkspacePanel>

            <!-- The blocking Steam-missing banner: the same condition gets the
                 same escalation on every affected view. -->
            <wsp:WorkspacePanel PanelKey="installedGames.steamMissing"
                                Classes="warning"
                                Glyph="&#xE7BA;"
                                Title="Steam was not found on this computer"
                                Subtitle="Game discovery needs a Steam installation. Install Steam, or scan again if it was just installed."
                                CanHide="False"
                                CanCollapse="False"
                                CanFloat="False"
                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSteamMissing}"
                                MinPanelWidth="320" />

            <!-- DataGrid owns one shared column measure for headers and every
                 row. Headers can be reordered/resized; visibility and order
                 persist. This is the panel that absorbs the page's slack. -->
            <wsp:WorkspacePanel PanelKey="installedGames.table"
                                Classes="table"
                                Title="Games"
                                SizeMode="Fill"
                                CanHide="False"
                                MinPanelWidth="320"
                                MinPanelHeight="200">
                <Grid RowDefinitions="*,Auto">

                    <DataGrid x:Name="GamesGrid"
                              Grid.Row="0"
                              Classes="installedGamesTable"
                              ItemsSource="{Binding Pagination.CurrentPageItems}"
                              SelectedItem="{Binding SelectedGame}"
                              IsVisible="{Binding !!Games.Count}"
                              AutomationProperties.Name="Installed games table"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowHeight="44"
                              Background="Transparent"
                              BorderThickness="0"
                              ColumnReordered="OnColumnReordered">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Game"
                                                    Tag="game"
                                                    Width="140"
                                                    MinWidth="140"
                                                    SortMemberPath="GameName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <TextBlock Text="{Binding GameName}"
                                                   ToolTip.Tip="{Binding GameName}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,12,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="AppID"
                                                Tag="appId"
                                                Binding="{Binding AppId}"
                                                Width="80"
                                                MinWidth="80"
                                                Foreground="{DynamicResource MutedTextBrush}"
                                                FontSize="{DynamicResource FontSizeBody}" />

                            <DataGridTemplateColumn Header="Install path"
                                                    Tag="installPath"
                                                    Width="160"
                                                    MinWidth="160"
                                                    SortMemberPath="InstallPath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <!-- Prefix ellipsis keeps the distinguishing
                                             tail of a path visible; end-truncation
                                             collapsed every row to the same
                                             ".../steamapps/common/..." prefix. -->
                                        <TextBlock Text="{Binding InstallPath}"
                                                   ToolTip.Tip="{Binding InstallPath}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,12,0"
                                                   TextTrimming="PrefixCharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Library"
                                                    Tag="library"
                                                    Width="115"
                                                    MinWidth="115"
                                                    SortMemberPath="LibraryPath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <TextBlock Text="{Binding LibraryPath}"
                                                   ToolTip.Tip="{Binding LibraryPath}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,12,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Approved"
                                                    Tag="approved"
                                                    Width="100"
                                                    MinWidth="100"
                                                    SortMemberPath="ApprovedMappings">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <TextBlock Text="{Binding ApprovedMappings, StringFormat='{}{0}'}"
                                                   Classes="countApproved"
                                                   FontWeight="Medium"
                                                   Classes.zero="{Binding !ApprovedMappings}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Pending"
                                                    Tag="pending"
                                                    Width="95"
                                                    MinWidth="95"
                                                    SortMemberPath="PendingMappings">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <TextBlock Text="{Binding PendingMappings, StringFormat='{}{0}'}"
                                                   Classes="countPending"
                                                   FontWeight="Medium"
                                                   Classes.zero="{Binding !PendingMappings}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Needs fix"
                                                    Tag="needsFix"
                                                    Width="95"
                                                    MinWidth="95"
                                                    SortMemberPath="NeedsFixMappings">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <TextBlock Text="{Binding NeedsFixMappings, StringFormat='{}{0}'}"
                                                   Classes="countNeedsFix"
                                                   FontWeight="Medium"
                                                   Classes.zero="{Binding !NeedsFixMappings}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Exists"
                                                    Tag="exists"
                                                    Width="85"
                                                    MinWidth="85"
                                                    SortMemberPath="SavePathExists">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <TextBlock Text="{Binding SavePathExistsDisplay}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Files"
                                                    Tag="files"
                                                    Width="85"
                                                    MinWidth="85"
                                                    SortMemberPath="FileCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding FileCount}"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}" />
                                            <TextBlock Text="{Binding TotalSizeDisplay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeMicro}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- The last column absorbs the slack so the table
                                 never leaves a headerless filler column against
                                 the card edge, and never overflows into a
                                 horizontal scrollbar when the widths are a few
                                 pixels over the content width. -->
                            <DataGridTemplateColumn Header="Status"
                                                    Tag="status"
                                                    Width="*"
                                                    MinWidth="120"
                                                    SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:InstalledGameRowViewModel">
                                        <TextBlock Text="{Binding Status}"
                                                   Classes="statusCell"
                                                   Classes.healthy="{Binding IsStatusHealthy}"
                                                   Classes.caution="{Binding IsStatusCaution}"
                                                   Classes.blocked="{Binding IsStatusBlocked}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: shown only when there are no games and no load is
                         in progress (avoids flashing during the startup scan). -->
                    <views:EmptyState Grid.Row="0"
                                      Glyph="&#xE8FD;"
                                      Title="No games found"
                                      Message="Scan your Steam libraries to see installed games and their save status.">
                        <views:EmptyState.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!Games.Count" />
                                <Binding Path="!IsLoading" />
                            </MultiBinding>
                        </views:EmptyState.IsVisible>
                        <views:EmptyState.ActionContent>
                            <Button Content="Scan Steam library"
                                    Classes="primary"
                                    Command="{Binding RefreshCommand}" />
                        </views:EmptyState.ActionContent>
                    </views:EmptyState>

                    <!-- Bottom pagination bar -->
                    <Border Grid.Row="1"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            Background="{DynamicResource InsetBackgroundBrush}"
                            Padding="16,8"
                            IsVisible="{Binding !!Games.Count}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Left: Page summary text -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Pagination.PageSummaryText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center" />

                            <!-- Right: Page size selector and page navigation -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="16">
                                <!-- Page size selector -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                    <TextBlock Text="Page size:"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Pagination.PageSizeOptions}"
                                              SelectedItem="{Binding Pagination.SelectedPageSizeOption}"
                                              ToolTip.Tip="Select page size"
                                              AutomationProperties.Name="Page size selector"
                                              MinWidth="72"
                                              VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Pagination.CustomPageSizeText}"
                                             IsVisible="{Binding Pagination.IsCustomPageSize}"
                                             PlaceholderText="Size"
                                             ToolTip.Tip="Enter custom page size (positive integer)"
                                             AutomationProperties.Name="Custom page size input"
                                             Width="60"
                                             VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Navigation buttons -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                    <Button Command="{Binding Pagination.FirstPageCommand}"
                                            ToolTip.Tip="First page"
                                            AutomationProperties.Name="First page"
                                            Content="«"
                                            Width="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                    <Button Command="{Binding Pagination.PreviousPageCommand}"
                                            ToolTip.Tip="Previous page"
                                            AutomationProperties.Name="Previous page"
                                            Content="‹"
                                            Width="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                    <TextBlock Text="{Binding Pagination.PageNumberText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Margin="8,0" />
                                    <Button Command="{Binding Pagination.NextPageCommand}"
                                            ToolTip.Tip="Next page"
                                            AutomationProperties.Name="Next page"
                                            Content="›"
                                            Width="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                    <Button Command="{Binding Pagination.LastPageCommand}"
                                            ToolTip.Tip="Last page"
                                            AutomationProperties.Name="Last page"
                                            Content="»"
                                            Width="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </wsp:WorkspacePanel>

        </wsp:WorkspaceSurface.Panels>
    </wsp:WorkspaceSurface>
</UserControl>
