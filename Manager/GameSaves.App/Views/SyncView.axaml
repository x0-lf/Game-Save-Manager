<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             xmlns:wsp="using:GameSaves.App.Views.Workspace"
             x:Class="GameSaves.App.Views.SyncView"
             x:DataType="vm:SyncViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <!-- Sync state colouring. The accent owns direction and selection;
             success, warning and danger keep their own meaning, so no accent
             choice can turn an ordinary upload into an alarm or an alarm into
             decoration. Every one of these states also carries its own words,
             so colour is never the only indicator. -->
        <Style Selector="TextBlock.syncState">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.syncState.direction">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.syncState.success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.syncState.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="TextBlock.syncState.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>

        <!-- The direction control is the selection. Its look lives on a chip
             inside the button rather than on the ToggleButton itself: the app
             deliberately makes every ToggleButton surface transparent (the
             rail and panel chrome depend on it), and the Fluent checked state
             paints its own foreground over anything set here. The chip reads
             the same IncludeInSync the button writes, so the two cannot
             disagree.

             Selected reads as the accent, because selection is an accent
             state everywhere else in the app. Disabled stays visibly disabled
             rather than merely quiet. -->
        <Style Selector="ToggleButton.syncDirection">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.syncDirectionChip">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        </Style>
        <Style Selector="Border.syncDirectionChip > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style Selector="Border.syncDirectionChip.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSelectionTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.syncDirectionChip.selected > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.syncDirection:pointerover Border.syncDirectionChip">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.syncDirection:disabled Border.syncDirectionChip">
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InsetBackgroundBrush}" />
        </Style>
        <Style Selector="ToggleButton.syncDirection:disabled Border.syncDirectionChip > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- No outer ScrollViewer: every region already scrolls itself, and a
         second one here would nest two scrollbars. -->
    <wsp:WorkspaceSurface Layout="{Binding Workspace}"
                          MaxWidth="1100"
                          Margin="0,12,24,14">
        <wsp:WorkspaceSurface.Panels>

            <!-- Header: always-visible controls and live progress -->
            <wsp:WorkspacePanel PanelKey="sync.header"
                                Classes="pageHeader"
                                Title="Sync"
                                Subtitle="Copy completed backup runs to a remote destination, preview first."
                                CanHide="False"
                                CanCollapse="False"
                                MinPanelWidth="320">
                <wsp:WorkspacePanel.HeaderActions>
                    <!-- Three previews, one engine. Each sets the direction
                         options below and rebuilds the plan; none of them
                         transfers anything, because the confirmation and Sync
                         Now still stand between a direction and a byte. -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Content="Preview upload"
                                ToolTip.Tip="Dry run of local-only runs going to the remote. Nothing is copied."
                                Command="{Binding PreviewUploadCommand}"
                                IsEnabled="{Binding CanPreviewSync}"
                                VerticalAlignment="Center" />

                        <Button Content="Preview download"
                                ToolTip.Tip="Dry run of remote-only runs coming to the local backup base. Nothing is copied."
                                Command="{Binding PreviewDownloadCommand}"
                                IsEnabled="{Binding CanPreviewSync}"
                                VerticalAlignment="Center" />

                        <Button Content="Preview both"
                                ToolTip.Tip="Dry run in both directions: nothing is copied until you confirm."
                                Classes="primary"
                                Command="{Binding PreviewBothDirectionsCommand}"
                                IsEnabled="{Binding CanPreviewSync}"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </wsp:WorkspacePanel.HeaderActions>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <!-- Both endpoints named before any preview runs, so
                         "upload" and "download" have an unmistakable
                         direction. Read from saved configuration only: no
                         remote call renders this, and no secret reaches it. -->
                    <Border Background="{DynamicResource InsetBackgroundBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="Local"
                                           Width="52"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />

                                <SelectableTextBlock Grid.Column="1"
                                                     Text="{Binding LocalEndpointDisplay}"
                                                     ToolTip.Tip="{Binding LocalEndpointDisplay}"
                                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                                     FontSize="{DynamicResource FontSizeBody}"
                                                     TextWrapping="Wrap"
                                                     VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Open"
                                        Command="{Binding OpenLocalBackupLocationCommand}"
                                        IsEnabled="{Binding CanOpenLocalBackupLocation}"
                                        ToolTip.Tip="Open the local backup folder. Nothing is copied, moved, or deleted."
                                        FontSize="{DynamicResource FontSizeBody}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="Remote"
                                           Width="52"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />

                                <SelectableTextBlock Grid.Column="1"
                                                     Text="{Binding RemoteEndpointDisplay}"
                                                     ToolTip.Tip="{Binding RemoteEndpointDisplay}"
                                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                                     FontSize="{DynamicResource FontSizeBody}"
                                                     TextWrapping="Wrap"
                                                     VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Open"
                                        Command="{Binding OpenRemoteLocationCommand}"
                                        IsEnabled="{Binding CanOpenRemoteLocation}"
                                        ToolTip.Tip="Open the remote location. Nothing is copied, moved, or deleted."
                                        FontSize="{DynamicResource FontSizeBody}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{Binding EndpointProfileStateDisplay}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding EndpointIssue}"
                                       IsVisible="{Binding HasEndpointIssue}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="2"
                                IsVisible="{Binding IsSyncRunning}">
                        <!-- Work in progress reads as the accent, like every
                             other live-progress surface in the app. -->
                        <ProgressBar Minimum="0"
                                     Maximum="{Binding ProgressMax}"
                                     Value="{Binding ProgressValue}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Height="14" />

                        <TextBlock Text="{Binding ProgressText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ProgressText}" />

                        <!-- Inside the running-sync panel, so it exists only while
                             there is something to cancel. -->
                        <Button Content="Cancel Sync"
                                Command="{Binding CancelSyncCommand}"
                                IsEnabled="{Binding CanCancelSync}"
                                HorizontalAlignment="Left"
                                FontSize="{DynamicResource FontSizeBody}"
                                ToolTip.Tip="Stop the sync. Files already copied are kept and nothing is deleted." />
                    </StackPanel>
                </StackPanel>
            </wsp:WorkspacePanel>

            <!-- Remote profile -->
            <wsp:WorkspacePanel PanelKey="sync.remoteProfile"
                                Title="Remote profile"
                                MinPanelWidth="320">
                <StackPanel Spacing="6">
                    <!-- Two equal columns, the same form grid Manual
                         backup uses: every field ends on its column
                         edge instead of a per-control measure. -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Saved profile"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold" />

                            <ComboBox ItemsSource="{Binding RemoteProfileOptions}"
                                      SelectedItem="{Binding SelectedRemoteProfileOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Profile name"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold" />

                            <Panel>
                                <TextBox Text="{Binding RemoteProfileDisplayName}"
                                         MaxLength="100" />
                                <TextBlock Text="Profile name, for example Home SFTP Server"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource FontSizeSubtitle}"
                                           Margin="12,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           IsVisible="{Binding !RemoteProfileDisplayName.Length}" />
                            </Panel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding RemoteProfileState}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Button Content="New"
                                Command="{Binding NewRemoteProfileCommand}" />
                        <Button Content="Save"
                                Classes="primary"
                                Command="{Binding SaveRemoteProfileCommand}" />
                        <Button
                                Content="More…"
                                ToolTip.Tip="More profile actions">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Save as new profile"
                                              Command="{Binding SaveRemoteProfileAsCommand}" />
                                    <MenuItem Header="Rename"
                                              Command="{Binding RenameRemoteProfileCommand}"
                                              IsEnabled="{Binding SelectedRemoteProfile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="Delete"
                                Classes="danger"
                                IsEnabled="{Binding SelectedRemoteProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="8" MaxWidth="560"
                                                HorizontalAlignment="Stretch" Margin="4">
                                        <TextBlock Text="Delete this profile?"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Only the selected profile configuration is deleted. Backup runs, remote files, sync history, archives and save files are never removed."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   TextWrapping="Wrap" />
                                        <CheckBox Content="I understand"
                                                  IsChecked="{Binding ConfirmDeleteRemoteProfile}"
                                                  FontSize="{DynamicResource FontSizeBody}" />
                                        <Button Content="Delete profile"
                                                Classes="danger"
                                                Command="{Binding DeleteRemoteProfileCommand}"
                                                HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </wsp:WorkspacePanel>

            <!-- Sync target and connection -->
            <wsp:WorkspacePanel PanelKey="sync.target"
                                Title="Sync target &amp; connection"
                                MinPanelWidth="320">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <!-- Provider selector -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Provider"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           FontWeight="SemiBold" />

                                <ComboBox ItemsSource="{Binding ProviderOptions}"
                                          SelectedValue="{Binding SelectedProviderKind}"
                                          SelectedValueBinding="{Binding Kind}"
                                          HorizontalAlignment="Stretch"
                                          ToolTip.Tip="{Binding ProviderCapabilitySummary}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="{Binding ProviderCapabilitySummary}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Sync behaviour shares the provider row grid -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Sync behaviour"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           FontWeight="SemiBold" />

                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                    <CheckBox Content="Upload local runs"
                                              IsChecked="{Binding UploadEnabled}"
                                              FontSize="{DynamicResource FontSizeBody}" />

                                    <CheckBox Content="Download remote runs"
                                              IsChecked="{Binding DownloadEnabled}"
                                              FontSize="{DynamicResource FontSizeBody}" />

                                    <CheckBox Content="Transfer runs as compressed archive (.7z)"
                                              IsChecked="{Binding ArchiveSync}"
                                              FontSize="{DynamicResource FontSizeBody}"
                                              ToolTip.Tip="Transfers whole backup runs as a single compressed .7z archive container, reducing cloud API request overhead and transfer latency." />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,2" />

                        <!-- Local folder target -->
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding IsLocalFolderSelected}">
                            <TextBlock Text="Folder location"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">

                                <TextBox Grid.Column="0"
                                         Text="{Binding RemoteRootPath}"
                                         PlaceholderText="Folder to sync backup runs with (NAS share, USB drive, cloud-synced folder)"
                                         ToolTip.Tip="{Binding RemoteRootPath}" />

                                <Button Grid.Column="1"
                                        Content="Choose folder…"
                                        Command="{Binding ChooseRemoteFolderCommand}"
                                        IsEnabled="{Binding CanSelectRemoteFolder}"
                                        VerticalAlignment="Top" />

                                <Button Grid.Column="2"
                                        Content="Open Folder"
                                        Command="{Binding OpenRemoteLocationCommand}"
                                        IsVisible="{Binding CanOpenRemoteLocation}"
                                        VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>

                        <!-- SFTP target -->
                        <StackPanel Spacing="8"
                                    IsVisible="{Binding IsSftpSelected}">
                            <TextBlock Text="SFTP connection"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="2*,90,*"
                                  ColumnSpacing="6">

                                <TextBox Grid.Column="0"
                                         Text="{Binding SftpHost}"
                                         PlaceholderText="Host name or IP address" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding SftpPort}"
                                         PlaceholderText="22"
                                         ToolTip.Tip="SSH port (default 22)" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding SftpUsername}"
                                         PlaceholderText="Username" />
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="14">
                                <RadioButton Content="Password"
                                             GroupName="SftpAuth"
                                             IsChecked="{Binding SftpUsePassword}"
                                             FontSize="{DynamicResource FontSizeBody}" />

                                <RadioButton Content="Private key file"
                                             GroupName="SftpAuth"
                                             IsChecked="{Binding SftpUsePrivateKey}"
                                             FontSize="{DynamicResource FontSizeBody}" />
                            </StackPanel>

                            <TextBox Text="{Binding SftpPassword}"
                                     PasswordChar="●"
                                     PlaceholderText="Password (kept in memory only, never stored)"
                                     IsVisible="{Binding SftpUsePassword}" />

                            <StackPanel Spacing="4"
                                        IsVisible="{Binding SftpUsePrivateKey}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="6">

                                    <TextBox Grid.Column="0"
                                             Text="{Binding SftpKeyFilePath}"
                                             PlaceholderText="Path to the private key file (e.g. C:\Users\you\.ssh\id_ed25519)"
                                             ToolTip.Tip="{Binding SftpKeyFilePath}" />

                                    <Button Grid.Column="1"
                                            Content="Browse…"
                                            Command="{Binding ChooseKeyFileCommand}"
                                            VerticalAlignment="Top" />
                                </Grid>

                                <TextBox Text="{Binding SftpKeyPassphrase}"
                                         PasswordChar="●"
                                         PlaceholderText="Key passphrase, if any (kept in memory only, never stored)" />
                            </StackPanel>

                            <TextBox Text="{Binding SftpRemotePath}"
                                     PlaceholderText="Remote folder path, e.g. /srv/gamesave-sync" />

                            <CheckBox Content="Trust this server's host key on first connect"
                                      IsChecked="{Binding SftpTrustNewHostKey}"
                                      FontSize="{DynamicResource FontSizeBody}"
                                      ToolTip.Tip="On the first connection the server's key fingerprint is stored (like SSH known_hosts). If it ever changes later, the sync fails loudly. Leave unchecked to see the fingerprint first without trusting it." />

                            <WrapPanel ItemSpacing="8" LineSpacing="6">
                                <Button Content="Forget Stored Host Key"
                                        Command="{Binding ForgetSftpHostKeyCommand}"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        ToolTip.Tip="Removes the stored fingerprint for this host and port, e.g. after a planned server reinstall." />

                                <TextBlock Text="Passwords and passphrases are never saved to disk."
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- Google Drive account configuration -->
                        <!-- One measure for the whole block. Its
                             paragraphs previously wrapped at three
                             different widths inside one card (one ran the
                             full 1070 px card while its siblings were
                             capped at 560), and its internal rule spanned
                             the card while the content it divides sits in
                             the left column. Constraining the container
                             once fixes both. See Round 41 P1-2. -->
                        <StackPanel IsVisible="{Binding IsGoogleDriveSelected}"
                                    Width="560"
                                    HorizontalAlignment="Left"
                                    Spacing="8">

                            <TextBlock Text="Google Drive account"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="16"
                                  RowSpacing="3">
                                <TextBlock Grid.Row="0" Text="{Binding GoogleDriveAccountLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GoogleDriveAccountDisplayText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Grid.Row="1" Text="Email" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GoogleDriveEmailDisplayText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Grid.Row="2" Text="Status" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GoogleDriveStatusDisplayText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" />
                            </Grid>

                            <TextBlock Text="Scope: only files created or opened by Game Save Manager"
                                       ToolTip.Tip="OAuth scope: drive.file"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />

                            <WrapPanel ItemSpacing="8" LineSpacing="6">
                                <Button Content="Connect Google Drive"
                                        Command="{Binding ConnectGoogleDriveCommand}"
                                        IsEnabled="{Binding CanConnectGoogleDrive}"
                                        IsVisible="{Binding CanShowConnectGoogleDrive}" />
                                <Button Content="Reconnect"
                                        Command="{Binding ReconnectGoogleDriveCommand}"
                                        IsEnabled="{Binding CanReconnectGoogleDrive}"
                                        IsVisible="{Binding CanShowReconnectGoogleDrive}" />
                                <Button Content="Disconnect"
                                        Command="{Binding DisconnectGoogleDriveCommand}"
                                        IsEnabled="{Binding CanDisconnectGoogleDrive}"
                                        IsVisible="{Binding CanShowDisconnectGoogleDrive}" />
                                <Button Content="Cancel"
                                        Command="{Binding CancelGoogleDriveConnectionCommand}"
                                        IsVisible="{Binding CanCancelGoogleDriveConnection}" />
                            </WrapPanel>

                            <CheckBox Content="Confirm removing locally stored Google Drive authentication"
                                      IsChecked="{Binding ConfirmDisconnectGoogleDrive}"
                                      IsVisible="{Binding CanShowDisconnectGoogleDrive}"
                                      ToolTip.Tip="The saved profile, local backups, remote Drive files, and Google Account grant remain. Connecting again will be required." />

                            <TextBlock Text="Disconnect removes protected authentication from this installation only. It does not delete the Google account, revoke access in Google Account settings, or remove Drive files."
                                       IsVisible="{Binding CanShowDisconnectGoogleDrive}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding GoogleDriveConnectionMessage}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />

                            <Border Height="1"
                                    Background="{DynamicResource SubtleBorderBrush}"
                                    Margin="0,4" />

                            <TextBlock Text="Application backup folder"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="16"
                                  RowSpacing="3">
                                <TextBlock Grid.Row="0"
                                           Text="Backup folder"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding GoogleDriveRootFolderDisplayText}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Grid.Row="1"
                                           Text="Folder status"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding GoogleDriveRootFolderStatusDisplayText}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <WrapPanel ItemSpacing="8" LineSpacing="6">
                                <Button Content="Set Up Drive Folder"
                                        Command="{Binding SetUpGoogleDriveRootFolderCommand}"
                                        IsEnabled="{Binding CanSetUpGoogleDriveRootFolder}"
                                        IsVisible="{Binding CanSetUpGoogleDriveRootFolder}" />
                                <Button Content="Check Drive Folder"
                                        Command="{Binding CheckGoogleDriveRootFolderCommand}"
                                        IsEnabled="{Binding CanCheckGoogleDriveRootFolder}"
                                        IsVisible="{Binding CanCheckGoogleDriveRootFolder}" />
                                <Button Content="Recreate Drive Folder"
                                        Command="{Binding RecreateGoogleDriveRootFolderCommand}"
                                        IsEnabled="{Binding CanRecreateGoogleDriveRootFolder}"
                                        IsVisible="{Binding CanShowRecreateGoogleDriveRootFolder}" />
                                <Button Content="Cancel Folder Operation"
                                        Command="{Binding CancelGoogleDriveRootFolderCommand}"
                                        IsVisible="{Binding CanCancelGoogleDriveRootFolderOperation}" />
                            </WrapPanel>

                            <CheckBox Content="Confirm creating or selecting a replacement Google Drive root folder"
                                      IsChecked="{Binding ConfirmRecreateGoogleDriveRootFolder}"
                                      IsVisible="{Binding CanShowRecreateGoogleDriveRootFolder}"
                                      ToolTip.Tip="The old Drive object, remote files, local backups, and saved profile remain. A new folder is created only when no unique existing candidate is available." />

                            <TextBlock Text="{Binding GoogleDriveRootFolderMessage}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Backups sync into this folder in your My Drive. Uploads only create files, downloads never overwrite local files, and nothing is ever deleted remotely."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />

                            <!-- Concise, because the full comparison belongs in
                                 the provider guide, not in a settings panel. -->
                            <TextBlock Text="Drive transfers are paced by file count and by Google's own rate limits, so a large first sync can take a long time. Slow is not failed: progress is per file and cancelling is safe. For bulk transfers you can instead point the Local or mounted folder provider at a Google Drive for desktop folder and let Google's client move the bytes. See the provider guide, Performance choices."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    IsVisible="{Binding CanLogout}">
                            <TextBlock Text="Stored authentication available"
                                       IsVisible="{Binding HasStoredAuthentication}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center" />
                            <Button Content="Disconnect"
                                    Command="{Binding DisconnectAuthenticationCommand}"
                                    IsEnabled="{Binding HasStoredAuthentication}"
                                    FontSize="{DynamicResource FontSizeBody}"
                                    ToolTip.Tip="Removes encrypted authentication only. The saved profile and backup data are kept." />
                        </StackPanel>

                        <WrapPanel ItemSpacing="8" LineSpacing="6" Margin="0,4,0,0">
                            <Button Content="Check connection"
                                    Command="{Binding CheckSyncStatusCommand}"
                                    IsVisible="{Binding CanCheckConnection}"
                                    FontSize="{DynamicResource FontSizeBody}"
                                    ToolTip.Tip="Connects to the sync target and reports whether the backup runs are in sync — without copying anything. Preview Sync (Dry Run) performs the same check automatically." />

                            <TextBlock Text="{Binding ConnectionCheckMessage}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </WrapPanel>

                        <TextBlock Text="Sync copies whole backup runs both ways. A run missing on one side is copied there — nothing is ever deleted or overwritten. Runs that differ on both sides are reported as conflicts and never copied automatically."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap"
                                   Width="560"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" />

                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <Border Background="{DynamicResource InsetBackgroundBrush}"
                                CornerRadius="8"
                                Padding="10,6"
                                VerticalAlignment="Center">
                            <CheckBox Content="I understand this will copy backup runs"
                                      IsChecked="{Binding ConfirmSync}"
                                      FontSize="{DynamicResource FontSizeBody}" />
                        </Border>
                        <!-- Offered only for a runnable plan, with runs
                             selected, and with the confirmation given. The
                             command refuses all three cases again anyway; this
                             just stops the button pretending otherwise. -->
                        <Button Content="Sync now"
                                Command="{Binding ExecuteSyncCommand}"
                                IsEnabled="{Binding CanExecuteSyncNow}"
                                VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </wsp:WorkspacePanel>

            <!-- Sync plan. The collapse state still lives on the view model,
                 so the panel chevron drives the property the Expander drove —
                 inverted, because a panel records "collapsed" where the
                 Expander recorded "expanded". -->
            <wsp:WorkspacePanel PanelKey="sync.plan"
                                Classes="table"
                                Title="Sync plan"
                                MinPanelWidth="320"
                                IsCollapsed="{Binding !PlanSectionExpanded, Mode=TwoWay}">
                <!-- The plan grows with its row count and the region scrolls as
                     one, so there is no inner scroller to trap the list in. -->
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">

                    <TextBlock Grid.Row="0"
                               Text="{Binding SummaryDisplay}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">

                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedSummaryDisplay}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="Select All"
                                Command="{Binding SelectAllRunsCommand}"
                                FontSize="{DynamicResource FontSizeBody}" />

                        <Button Grid.Column="2"
                                Content="Select None"
                                Command="{Binding DeselectAllRunsCommand}"
                                FontSize="{DynamicResource FontSizeBody}" />
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="0,6,0,6"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding !!Items.Count}">

                        <Grid ColumnDefinitions="100,1.7*,165,0.9*,80,80,1.3*"
                              ColumnSpacing="10">

                            <TextBlock Grid.Column="0" Text="Action" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="Run" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="Where it is" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" />
                            <TextBlock Grid.Column="3" Text="Game" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" />
                            <TextBlock Grid.Column="4" Text="Files" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" />
                            <TextBlock Grid.Column="5" Text="Size" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" />
                            <TextBlock Grid.Column="6" Text="Status" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Spacing="4">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SyncItemRowViewModel">
                                    <Border Padding="0,6"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1">

                                        <Grid ColumnDefinitions="100,1.7*,165,0.9*,80,80,1.3*"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="10">

                                            <!-- The visible action is the
                                                 selection. It writes the same
                                                 IncludeInSync the Select All
                                                 and Select None actions write,
                                                 so there is one selection
                                                 state, not two. Conflict and
                                                 In sync rows are disabled: the
                                                 safety model never copies
                                                 them. Space and Enter toggle
                                                 it, because it is a real
                                                 ToggleButton rather than a
                                                 clickable label. -->
                                            <ToggleButton Grid.Row="0" Grid.Column="0"
                                                          Classes="syncDirection"
                                                          IsChecked="{Binding IncludeInSync}"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          FontSize="{DynamicResource FontSizeBody}"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding ActionAccessibleName}"
                                                          AutomationProperties.HelpText="{Binding ActionToolTip}"
                                                          ToolTip.Tip="{Binding ActionToolTip}">
                                                <Border Classes="syncDirectionChip"
                                                        Classes.selected="{Binding IncludeInSync}">
                                                    <TextBlock Text="{Binding ActionText}"
                                                               FontSize="{DynamicResource FontSizeBody}" />
                                                </Border>
                                            </ToggleButton>

                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding RunName}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       ToolTip.Tip="{Binding RunName}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                       Classes="syncState"
                                                       Classes.direction="{Binding IsDirectionState}"
                                                       Classes.success="{Binding IsSuccessState}"
                                                       Classes.warning="{Binding IsWarningState}"
                                                       Classes.danger="{Binding IsDangerState}"
                                                       Text="{Binding PresenceText}"
                                                       ToolTip.Tip="{Binding PresenceText}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Row="0" Grid.Column="3"
                                                       Text="{Binding GameName}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Row="0" Grid.Column="4"
                                                       Text="{Binding FilesDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="0" Grid.Column="5"
                                                       Text="{Binding SizeDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="0" Grid.Column="6"
                                                       Text="{Binding StatusText}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />

                                            <!-- Both display locations and the
                                                 time both sides were last read,
                                                 selectable so a long path can
                                                 be copied out. -->
                                            <StackPanel Grid.Row="1"
                                                        Grid.Column="1"
                                                        Grid.ColumnSpan="6"
                                                        Margin="0,2,0,0"
                                                        Spacing="1">
                                                <SelectableTextBlock Text="{Binding LocalLocationDisplay}"
                                                                     ToolTip.Tip="{Binding LocalLocationDisplay}"
                                                                     Foreground="{DynamicResource MutedTextBrush}"
                                                                     FontSize="{DynamicResource FontSizeCaption}"
                                                                     TextWrapping="Wrap" />

                                                <SelectableTextBlock Text="{Binding RemoteLocationDisplay}"
                                                                     ToolTip.Tip="{Binding RemoteLocationDisplay}"
                                                                     Foreground="{DynamicResource MutedTextBrush}"
                                                                     FontSize="{DynamicResource FontSizeCaption}"
                                                                     TextWrapping="Wrap" />

                                                <TextBlock Text="{Binding LastVerifiedDisplay}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{DynamicResource FontSizeCaption}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <views:EmptyState Glyph="&#xE895;"
                                          Title="No sync plan yet"
                                          Message="Run Preview Sync (Dry Run) to see which backup runs would be copied."
                                          IsVisible="{Binding !Items.Count}" />
                    </StackPanel>
                </Grid>
            </wsp:WorkspacePanel>

            <!-- Warnings -->
            <wsp:WorkspacePanel PanelKey="sync.warnings"
                                Title="Warnings"
                                MinPanelWidth="320"
                                IsCollapsed="{Binding !WarningsSectionExpanded, Mode=TwoWay}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TransferWarningRowViewModel">
                                <Border Padding="0,6"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1">

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <TextBlock Text="{Binding SeverityText}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Width="60" />

                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <views:EmptyState Glyph="&#xE930;"
                                      Title="No warnings"
                                      Message="Warnings from the sync preview and execution appear here."
                                      IsVisible="{Binding !Warnings.Count}" />
                </StackPanel>
            </wsp:WorkspacePanel>

            <!-- Execution results -->
            <wsp:WorkspacePanel PanelKey="sync.results"
                                Title="Execution results"
                                MinPanelWidth="320"
                                IsCollapsed="{Binding !ResultsSectionExpanded, Mode=TwoWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ExecutionStatusMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <!-- Transfer and verification are separate states. A run
                         that was copied is not called verified until both
                         sides have been read again, and that check never
                         copies, moves, or deletes anything. -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding VerificationStatusMessage}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="Verify"
                                Command="{Binding VerifyLastSyncCommand}"
                                IsEnabled="{Binding CanVerifyLastSync}"
                                ToolTip.Tip="Re-read both sides and report what is actually there. Nothing is copied; a completed transfer is never repeated."
                                FontSize="{DynamicResource FontSizeBody}" />

                        <Button Grid.Column="2"
                                Content="Stop check"
                                Command="{Binding CancelVerificationCommand}"
                                IsVisible="{Binding CanCancelVerification}"
                                FontSize="{DynamicResource FontSizeBody}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ExecutionResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SyncItemResultRowViewModel">
                                <Border Padding="0,6"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1">

                                    <Grid ColumnDefinitions="2*,220,160,90"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="10">

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding RunName}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   ToolTip.Tip="{Binding RunName}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Classes="syncState"
                                                   Classes.direction="{Binding IsDirectionState}"
                                                   Classes.success="{Binding IsSuccessState}"
                                                   Classes.warning="{Binding IsWarningState}"
                                                   Classes.danger="{Binding IsDangerState}"
                                                   Text="{Binding StateText}"
                                                   ToolTip.Tip="{Binding StateDetail}"
                                                   AutomationProperties.HelpText="{Binding StateDetail}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding AffectedSideText}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="0" Grid.Column="3"
                                                   Text="{Binding SizeDisplay}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}" />

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="4"
                                                    Margin="0,2,0,0"
                                                    Spacing="1">
                                            <TextBlock Text="{Binding StateDetail}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Text="{Binding Error}"
                                                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </wsp:WorkspacePanel>

            <!-- Sync history -->
            <wsp:WorkspacePanel PanelKey="sync.history"
                                Title="Sync history"
                                MinPanelWidth="320"
                                IsCollapsed="{Binding !HistorySectionExpanded, Mode=TwoWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Every executed sync, from the log stored alongside the sync folder — shared by all devices syncing with it."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding SyncLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SyncLogEntryRowViewModel">
                                <Border Padding="0,6"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1">

                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10">
                                            <TextBlock Text="{Binding TimestampDisplay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}" />

                                            <TextBlock Text="{Binding DeviceName}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}" />

                                            <TextBlock Text="{Binding SummaryDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding RunsDisplay}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSizeMicro}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <views:EmptyState Glyph="&#xE81C;"
                                      Title="No sync history yet"
                                      Message="Executed syncs are recorded here, shared by every device using the same sync folder."
                                      IsVisible="{Binding !SyncLog.Count}" />
                </StackPanel>
            </wsp:WorkspacePanel>

        </wsp:WorkspaceSurface.Panels>
    </wsp:WorkspaceSurface>
</UserControl>
