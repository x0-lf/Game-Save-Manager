<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             x:Class="GameSaves.App.Views.TransferHistoryView"
             x:DataType="vm:TransferHistoryViewModel"
             Background="{DynamicResource PageBackgroundBrush}">


    <ScrollViewer Classes="pageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="10"
          Margin="0,12,0,14"
          MaxWidth="1100">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10">

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">

                <StackPanel Grid.Column="0"
                            Spacing="2">
                    <TextBlock Text="History" Classes="h1" />

                    <TextBlock Text="A record of every copy, restore and backup."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshRunsCommand}"
                        Height="34"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Runs / items (resizable) -->
        <Grid Grid.Row="1" x:Name="SplitGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260" MaxWidth="640" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Runs list -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="0">

                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0"
                            Padding="12,8"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1">

                        <StackPanel Spacing="2">
                            <TextBlock Text="Executed runs"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Recorded automatically."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Runs}"
                             SelectedItem="{Binding SelectedRun}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TransferRunRowViewModel">
                                <StackPanel Spacing="3"
                                            Margin="4">

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <TextBlock Text="{Binding KindText}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSizeBody}" />

                                        <TextBlock Text="{Binding GameName}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding StartedDisplay}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}" />

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <TextBlock Text="{Binding ProfilesDisplay}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}" />

                                        <TextBlock Text="{Binding CountsDisplay}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}" />

                                        <TextBlock Text="{Binding BytesDisplay}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding FlagsDisplay}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="{DynamicResource FontSizeBody}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <views:EmptyState Grid.Row="1"
                                      Glyph="&#xE81C;"
                                      Title="No runs yet"
                                      Message="Executed transfers appear here after you copy, restore, or back up saves."
                                      IsVisible="{Binding !Runs.Count}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          Margin="1,0"
                          Background="Transparent"
                          ResizeDirection="Columns" />

            <!-- Items of the selected run -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="0">

                <Grid RowDefinitions="Auto,Auto,Auto,*">

                    <Border Grid.Row="0"
                            Padding="12,8"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1">

                        <StackPanel Spacing="2">
                            <TextBlock Text="Files in this run"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold" IsVisible="{Binding !!Runs.Count}" />
                            <TextBlock Text="Run files"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBodyLarge}"
                                       FontWeight="SemiBold" IsVisible="{Binding !Runs.Count}" />

                            <TextBlock Text="Exactly what was copied, skipped, or failed, per file."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="12,6"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding SelectedRun.WasBlocked, FallbackValue=False}">

                        <TextBlock Text="{Binding SelectedRun.BlockedReason, StringFormat='Run was blocked: {0}'}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="2"
                            Padding="10,6"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding !!RunItems.Count}">

                        <Grid ColumnDefinitions="2*,2*,80,150,*"
                              ColumnSpacing="10">

                            <TextBlock Grid.Column="0"
                                       Text="Source file"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="1"
                                       Text="Target file"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="2"
                                       Text="Size"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="3"
                                       Text="Status"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="4"
                                       Text="Details"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <views:EmptyState Grid.Row="3"
                                      Glyph="&#xE7C3;"
                                      Title="No files yet"
                                      Message="Files will appear here once a run exists."
                                      IsVisible="{Binding !Runs.Count}" />

                    <views:EmptyState Grid.Row="3"
                                      Glyph="&#xE7C3;"
                                      Title="No run selected"
                                      Message="Select a run to see the files it copied.">
                        <views:EmptyState.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!!Runs.Count" />
                                <Binding Path="!RunItems.Count" />
                            </MultiBinding>
                        </views:EmptyState.IsVisible>
                    </views:EmptyState>

                    <ScrollViewer Grid.Row="3"
                                  IsVisible="{Binding !!RunItems.Count}">
                        <ItemsControl ItemsSource="{Binding RunItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TransferRunItemRowViewModel">
                                    <Border Padding="10,6"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="2*,2*,80,150,*"
                                                  ColumnSpacing="10">

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SourceFile}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           ToolTip.Tip="{Binding SourceFile}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TargetFile}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           ToolTip.Tip="{Binding TargetFile}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SizeDisplay}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           Foreground="{DynamicResource MutedTextBrush}" />

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Status}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Error}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           TextWrapping="Wrap" />
                                            </Grid>

                                            <TextBlock Text="{Binding BackupDisplay}"
                                                       IsVisible="{Binding HasBackup}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="{DynamicResource FontSizeMicro}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
