<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             xmlns:wsp="using:GameSaves.App.Views.Workspace"
             x:Class="GameSaves.App.Views.TransferHistoryView"
             x:DataType="vm:TransferHistoryViewModel"
             Background="Transparent">

    <wsp:WorkspaceSurface Layout="{Binding Workspace}"
                          MaxWidth="1100"
                          Margin="0,12,24,14">
        <wsp:WorkspaceSurface.Panels>

            <wsp:WorkspacePanel PanelKey="history.header"
                                Classes="pageHeader"
                                Title="History"
                                Subtitle="A record of every copy, restore and backup."
                                CanHide="False"
                                MinPanelWidth="320">
                <wsp:WorkspacePanel.HeaderActions>
                    <Button Content="Refresh"
                            Command="{Binding RefreshRunsCommand}"
                            VerticalAlignment="Center" />
                </wsp:WorkspacePanel.HeaderActions>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextWrapping="Wrap" />
            </wsp:WorkspacePanel>

            <!-- The run list and the selected run's files used to be a fixed
                 two-column split grid. The surface's own left/centre regions
                 and their splitter carry that now, so the page no longer
                 builds one of its own. -->
            <wsp:WorkspacePanel PanelKey="history.runs"
                                Classes="table"
                                Title="Executed runs"
                                Subtitle="Recorded automatically."
                                CanHide="False"
                                MinPanelWidth="280"
                                MaxPanelWidth="640">

                <Grid RowDefinitions="*,Auto">
                    <Grid Grid.Row="0">
                        <ListBox ItemsSource="{Binding Pagination.CurrentPageItems}"
                                 SelectedItem="{Binding SelectedRun}"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TransferRunRowViewModel">
                                    <StackPanel Spacing="3"
                                                Margin="4">

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <TextBlock Text="{Binding KindText}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{DynamicResource FontSizeBody}" />

                                            <TextBlock Text="{Binding GameName}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding StartedDisplay}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}" />

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <TextBlock Text="{Binding ProfilesDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}" />

                                            <TextBlock Text="{Binding CountsDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}" />

                                            <TextBlock Text="{Binding BytesDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    ToolTip.Tip="{Binding VerificationTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding VerificationGlyph}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="{DynamicResource FontSizeMicro}" />
                                                    <TextBlock Text="{Binding VerificationDisplay}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontSize="{DynamicResource FontSizeMicro}" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding FlagsDisplay}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <views:EmptyState Glyph="&#xE81C;"
                                          Title="No runs yet"
                                          Message="Executed transfers appear here after you copy, restore, or back up saves."
                                          IsVisible="{Binding !Runs.Count}" />
                    </Grid>

                    <!-- Bottom pagination bar -->
                    <Border Grid.Row="1"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            Background="{DynamicResource InsetBackgroundBrush}"
                            Padding="12,8"
                            IsVisible="{Binding !!Runs.Count}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Left: Page summary text -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Pagination.PageSummaryText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       VerticalAlignment="Center" />

                            <!-- Right: Page size selector and page navigation -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <!-- Page size selector -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                    <TextBlock Text="Page size:"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Pagination.PageSizeOptions}"
                                              SelectedItem="{Binding Pagination.SelectedPageSizeOption}"
                                              ToolTip.Tip="Select page size"
                                              AutomationProperties.Name="Page size selector"
                                              MinWidth="72"
                                              VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Pagination.CustomPageSizeText}"
                                             IsVisible="{Binding Pagination.IsCustomPageSize}"
                                             PlaceholderText="Size"
                                             ToolTip.Tip="Enter custom page size (positive integer)"
                                             AutomationProperties.Name="Custom page size input"
                                             Width="60"
                                             VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Navigation buttons -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                    <Button Command="{Binding Pagination.FirstPageCommand}"
                                            ToolTip.Tip="First page"
                                            AutomationProperties.Name="First page"
                                            Content="«"
                                            Width="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                    <Button Command="{Binding Pagination.PreviousPageCommand}"
                                            ToolTip.Tip="Previous page"
                                            AutomationProperties.Name="Previous page"
                                            Content="‹"
                                            Width="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                    <TextBlock Text="{Binding Pagination.PageNumberText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Margin="8,0" />
                                    <Button Command="{Binding Pagination.NextPageCommand}"
                                            ToolTip.Tip="Next page"
                                            AutomationProperties.Name="Next page"
                                            Content="›"
                                            Width="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                    <Button Command="{Binding Pagination.LastPageCommand}"
                                            ToolTip.Tip="Last page"
                                            AutomationProperties.Name="Last page"
                                            Content="»"
                                            Width="32"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </wsp:WorkspacePanel>

            <wsp:WorkspacePanel PanelKey="history.files"
                                Classes="table"
                                Title="Run files"
                                Subtitle="Exactly what was copied, skipped, or failed, per file."
                                MinPanelWidth="380"
                                MinPanelHeight="160">

                <Grid RowDefinitions="Auto,Auto,*">

                    <Border Grid.Row="0"
                            Padding="12,6"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding SelectedRun.WasBlocked, FallbackValue=False}">

                        <TextBlock Text="{Binding SelectedRun.BlockedReason, StringFormat='Run was blocked: {0}'}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- The column band and the rows below share one padding so
                         their columns line up, and it matches BackupHistoryView. -->
                    <Border Grid.Row="1"
                            Padding="10,6"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding !!RunItems.Count}">

                        <Grid ColumnDefinitions="2*,2*,80,150,*"
                              ColumnSpacing="10">

                            <TextBlock Grid.Column="0"
                                       Text="Source file"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="1"
                                       Text="Target file"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="2"
                                       Text="Size"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="3"
                                       Text="Status"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="4"
                                       Text="Details"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <views:EmptyState Grid.Row="2"
                                      Glyph="&#xE7C3;"
                                      Title="No files yet"
                                      Message="Files will appear here once a run exists."
                                      IsVisible="{Binding !Runs.Count}" />

                    <views:EmptyState Grid.Row="2"
                                      Glyph="&#xE7C3;"
                                      Title="No run selected"
                                      Message="Select a run to see the files it copied.">
                        <views:EmptyState.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!!Runs.Count" />
                                <Binding Path="!RunItems.Count" />
                            </MultiBinding>
                        </views:EmptyState.IsVisible>
                    </views:EmptyState>

                    <ListBox Grid.Row="2"
                             Classes="virtualizedTable"
                             ItemsSource="{Binding RunItems}"
                             IsVisible="{Binding !!RunItems.Count}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Executed run files list">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TransferRunItemRowViewModel">
                                <Border Padding="10,6"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1">

                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="2*,2*,80,150,*"
                                              ColumnSpacing="10">

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SourceFile}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       ToolTip.Tip="{Binding SourceFile}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TargetFile}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       ToolTip.Tip="{Binding TargetFile}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SizeDisplay}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Status}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Error}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextWrapping="Wrap" />
                                        </Grid>

                                        <TextBlock Text="{Binding BackupDisplay}"
                                                   IsVisible="{Binding HasBackup}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="{DynamicResource FontSizeMicro}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </wsp:WorkspacePanel>

        </wsp:WorkspaceSurface.Panels>
    </wsp:WorkspaceSurface>
</UserControl>
