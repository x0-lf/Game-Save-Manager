<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:GameSaves.App.Views"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:wsp="using:GameSaves.App.Views.Workspace"
             x:Class="GameSaves.App.Views.TransferPreviewView"
             x:DataType="vm:TransferPreviewViewModel"
             Background="{DynamicResource PageBackgroundBrush}">

    <!-- Border.confirmGate lives in Themes/Controls.axaml: a floated panel is
         reparented into its own window, where UserControl.Styles no longer
         apply and the gate would lose its armed tint. -->

    <UserControl.Resources>

        <!-- Shared row template for both preview groups -->
        <DataTemplate x:Key="PreviewItemRowTemplate"
                      x:DataType="models:TransferPreviewItemRowViewModel">
            <Border Padding="10,8"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1">

                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="2*,2*,60,60,80,120"
                          ColumnSpacing="10">

                        <TextBlock Grid.Column="0"
                                   Text="{Binding SourcePath}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   ToolTip.Tip="{Binding SourcePath}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding TargetPath}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   ToolTip.Tip="{Binding TargetPath}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding SourceExistsText}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource AccentBrush}" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding TargetExistsText}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource WarningBrush}" />

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{Binding FileCount}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Text="{Binding TotalSizeDisplay}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeMicro}" />
                        </StackPanel>

                        <TextBlock Grid.Column="5"
                                   Text="{Binding StatusText}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <TextBlock Text="{Binding ActionText}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Shared column header for both preview groups -->
        <DataTemplate x:Key="PreviewColumnsHeaderTemplate">
            <Grid ColumnDefinitions="2*,2*,60,60,80,120"
                  ColumnSpacing="10">

                <TextBlock Grid.Column="0"
                           Text="Source path"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontWeight="Bold" />

                <TextBlock Grid.Column="1"
                           Text="Target path"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontWeight="Bold" />

                <TextBlock Grid.Column="2"
                           Text="Source"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontWeight="Bold" />

                <TextBlock Grid.Column="3"
                           Text="Target"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontWeight="Bold" />

                <TextBlock Grid.Column="4"
                           Text="Files"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontWeight="Bold" />

                <TextBlock Grid.Column="5"
                           Text="Status"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           FontWeight="Bold" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The page is a workspace: every section below is a panel the user can
         move, collapse, float or hide. The surface owns the regions, the
         splitters and the page scroll, so no section carries card chrome of
         its own any more. -->
    <wsp:WorkspaceSurface Layout="{Binding Workspace}"
                          MaxWidth="1100"
                          Margin="0,12,24,14">
        <wsp:WorkspaceSurface.Panels>

            <wsp:WorkspacePanel PanelKey="transferPreview.header"
                                Classes="pageHeader"
                                Title="Transfer profiles"
                                Subtitle="Copy saves between two Steam profiles, preview first."
                                CanHide="False">
                <wsp:WorkspacePanel.HeaderActions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Content="Refresh"
                                Command="{Binding RefreshInputsCommand}"
                                VerticalAlignment="Center" />

                        <Button Content="Preview copy"
                                ToolTip.Tip="Dry run: nothing is copied until you confirm."
                                IsEnabled="{Binding !!Profiles.Count}"
                                Classes="primary"
                                Command="{Binding PreviewTransferCommand}"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </wsp:WorkspacePanel.HeaderActions>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextWrapping="Wrap" />
            </wsp:WorkspacePanel>

            <!-- Nothing on this page works without profiles, so the banner
                 cannot be collapsed, floated or hidden out of the way. -->
            <wsp:WorkspacePanel PanelKey="transferPreview.noProfiles"
                                Classes="warning"
                                Glyph="&#xE7BA;"
                                Title="No profiles found"
                                Subtitle="Scan for profiles first, then come back to preview a copy."
                                CanHide="False"
                                CanCollapse="False"
                                CanFloat="False"
                                IsVisible="{Binding !Profiles.Count}">
                <wsp:WorkspacePanel.HeaderActions>
                    <Button Content="Go to Profiles"
                            Click="OnGoToProfilesClick"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            FontSize="{DynamicResource FontSizeBody}"
                            VerticalAlignment="Center" />
                </wsp:WorkspacePanel.HeaderActions>
            </wsp:WorkspacePanel>

            <wsp:WorkspacePanel PanelKey="transferPreview.inputs"
                                Title="Transfer inputs">

                <Grid ColumnDefinitions="*,*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="14"
                      RowSpacing="8">

                    <StackPanel Grid.Column="0"
                                Spacing="4">
                        <TextBlock Text="Source profile"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Bold" />

                        <Panel>
                            <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedSourceProfile}"
                                  HorizontalAlignment="Stretch" />
                            <TextBlock Text="Select a source profile"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       Margin="12,0,32,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding SelectedSourceProfile, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Panel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock Text="Target profile"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Bold" />

                        <Panel>
                            <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedTargetProfile}"
                                  HorizontalAlignment="Stretch" />
                            <TextBlock Text="Select a target profile"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       Margin="12,0,32,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding SelectedTargetProfile, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Panel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Spacing="4">
                        <TextBlock Text="Installed game"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Bold" />

                        <Panel>
                            <ComboBox ItemsSource="{Binding Games}"
                                  SelectedItem="{Binding SelectedGame}"
                                  HorizontalAlignment="Stretch" />
                            <TextBlock Text="Select a game"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       Margin="12,0,32,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding SelectedGame, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Panel>

                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Spacing="4">
                        <TextBlock Text="Transfer source"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />

                        <CheckBox Content="Include Steam userdata game folder"
                                  IsChecked="{Binding IncludeSteamUserDataGameFolder}"
                                  FontSize="{DynamicResource FontSizeBody}"
                                  ToolTip.Tip="Copies the full &lt;SteamRoot&gt;\userdata\&lt;profile&gt;\&lt;AppId&gt; folder from the source profile to the target profile. This is useful for Steam Cloud/userdata saves." />

                        <CheckBox Content="Include approved save-path mappings"
                                  IsChecked="{Binding IncludeApprovedMappings}"
                                  FontSize="{DynamicResource FontSizeBody}"
                                  ToolTip.Tip="Copies save locations from the approved mapping database (gamesave.db), expanded for the selected profiles. Only mappings reviewed as Approved are used." />

                        <TextBlock Text="Select at least one transfer source."
                                   IsVisible="{Binding !HasAnyTransferSource}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </wsp:WorkspacePanel>

            <!-- Summary fills its region. The width bounds are the baseline's
                 summary column (MinWidth 220, MaxWidth 520): the copy controls
                 read as a form, not a stretched band. The region scrolls for
                 us, so the card holds a plain stack as it always did. -->
            <wsp:WorkspacePanel PanelKey="transferPreview.summary"
                                Title="Summary"
                                Subtitle="Totals and copy controls."
                                MinPanelWidth="220"
                                MaxPanelWidth="520">

                <StackPanel Spacing="6">

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2" ColumnSpacing="16" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="Files to consider" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSizeBody}" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalFiles, StringFormat='{}{0}'}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Total size" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource FontSizeBody}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalSizeDisplay, StringFormat='{}{0}'}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock IsVisible="False" Text="{Binding TotalFiles, StringFormat='Files to consider: {0}'}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock IsVisible="False" Text="{Binding TotalSizeDisplay, StringFormat='Total size: {0}'}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="Ready to copy"
                               IsVisible="{Binding CanExecuteCopy}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource SuccessBrush}" />

                    <TextBlock Text="Not ready to copy — run a preview first"
                               IsVisible="{Binding !CanExecuteCopy}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource MutedTextBrush}" />

                    <TextBlock Text="{Binding SteamUserDataSourceText, StringFormat='Steam userdata: {0}'}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="{Binding ApprovedMappingsSourceText, StringFormat='Approved mappings: {0}'}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="{Binding BlockedItemCount, StringFormat='Blocked items: {0}'}"
                               IsVisible="{Binding HasBlockedItemsInPreview}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource WarningBrush}" />

                    <CheckBox Content="Skip blocked items and copy the rest"
                              IsChecked="{Binding SkipBlockedItems}"
                              IsVisible="{Binding HasBlockedItemsInPreview}"
                              FontSize="{DynamicResource FontSizeBody}"
                              ToolTip.Tip="Items with errors (for example a save location that resolves to the same path for both profiles) are never copied. Enable this to copy the remaining safe items anyway; each blocked item is reported as skipped in the execution results." />

                    <TextBlock Text="Copy only. Source files are never deleted or modified. Existing target files are skipped unless overwrite is enabled."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <Border Classes="confirmGate"
                            Classes.armed="{Binding ConfirmRealTransfer}"
                            CornerRadius="8"
                            Padding="10,6">
                        <CheckBox Content="I understand this will copy files into the target profile"
                              IsChecked="{Binding ConfirmRealTransfer}"
                              FontSize="{DynamicResource FontSizeBody}" />
                    </Border>

                    <CheckBox Content="Overwrite existing target files"
                              IsChecked="{Binding OverwriteExisting}"
                              FontSize="{DynamicResource FontSizeBody}" />

                    <CheckBox Margin="24,0,0,0"
                              Content="Back up files before overwriting (recommended)"
                              IsChecked="{Binding BackupBeforeOverwrite}"
                              IsEnabled="{Binding OverwriteExisting}"
                              FontSize="{DynamicResource FontSizeBody}"
                              ToolTip.Tip="Safe Mode: before a target file is overwritten, a copy of it is stored in the app's TransferBackups folder with a SHA-256 manifest. If a backup fails, that file is not overwritten." />

                    <Button Content="Copy to target profile"
                            Command="{Binding ExecuteTransferCommand}"
                            IsEnabled="{Binding CanExecuteCopy}"
                            HorizontalAlignment="Stretch" />

                    <TextBlock Text="{Binding ExecutionStatusMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <StackPanel Spacing="6"
                                IsVisible="{Binding !!ExecutionResults.Count}">

                        <TextBlock Text="{Binding FilesCopied, StringFormat='Files copied: {0}'}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource SuccessBrush}" />

                        <TextBlock Text="{Binding FilesSkipped, StringFormat='Files skipped: {0}'}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource MutedTextBrush}" />

                        <TextBlock Text="{Binding BytesCopiedDisplay, StringFormat='Data copied: {0}'}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource MutedTextBrush}" />

                        <TextBlock Text="{Binding FilesBackedUp, StringFormat='Files backed up before overwrite: {0}'}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource AccentBrush}" />

                        <TextBlock Text="{Binding BackupLocationMessage}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </wsp:WorkspacePanel>

            <!-- The whole warnings card was conditional on there being
                 warnings, so the condition rides the panel. -->
            <wsp:WorkspacePanel PanelKey="transferPreview.warnings"
                                Title="Warnings"
                                IsVisible="{Binding !!Warnings.Count}">

                <Panel>
                    <TextBlock Text="Warnings appear here after a preview."
                               IsVisible="{Binding !Warnings.Count}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}" />

                    <ScrollViewer IsVisible="{Binding !!Warnings.Count}">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TransferWarningRowViewModel">
                                    <Border Padding="12,6"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1">

                                        <!-- A Grid, not a horizontal StackPanel: a
                                             stack measures its children with
                                             unbounded width, so TextWrapping on
                                             the message never applied and a long
                                             warning ran off the panel edge. -->
                                        <Grid ColumnDefinitions="60,*"
                                              ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SeverityText}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Message}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </wsp:WorkspacePanel>

            <!-- Grouped preview items and execution results. Fills the region
                 and scrolls inside itself, as the results pane always did. -->
            <wsp:WorkspacePanel PanelKey="transferPreview.results"
                                Classes="table"
                                Title="Preview results"
                                Subtitle="Every file the copy would touch, grouped by source, with any warnings."
                                MinPanelWidth="420"
                                MinPanelHeight="200">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Panel>
                        <views:EmptyState Glyph="&#xE890;"
                                          Title="No preview yet"
                                          Message="Run Preview copy to see every file that would be copied, with any warnings, before anything happens.">
                            <views:EmptyState.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!UserDataItems.Count" />
                                    <Binding Path="!MappingItems.Count" />
                                    <Binding Path="!Warnings.Count" />
                                    <Binding Path="!ExecutionResults.Count" />
                                </MultiBinding>
                            </views:EmptyState.IsVisible>
                        </views:EmptyState>
                        <StackPanel Spacing="10">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="!!UserDataItems.Count" />
                                    <Binding Path="!!MappingItems.Count" />
                                    <Binding Path="!!Warnings.Count" />
                                    <Binding Path="!!ExecutionResults.Count" />
                                </MultiBinding>
                            </StackPanel.IsVisible>

                            <!-- Group: Steam userdata game folder -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="0">

                                <Grid RowDefinitions="Auto,Auto,Auto">

                                    <Border Grid.Row="0"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <TextBlock Text="Steam userdata game folder"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="{DynamicResource FontSizeBodyLarge}"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Text="Excluded from this preview"
                                                           IsVisible="{Binding !IncludeSteamUserDataGameFolder}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="The whole game-specific folder under the source profile's Steam userdata, copied into the target profile."
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Padding="10,6"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            IsVisible="{Binding !!UserDataItems.Count}">

                                        <ContentControl Content=""
                                                        ContentTemplate="{StaticResource PreviewColumnsHeaderTemplate}" />
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="Files from the source profile's Steam userdata appear here after a preview."
                                               IsVisible="{Binding !UserDataItems.Count}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Margin="12,10" />

                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding UserDataItems}"
                                                  ItemTemplate="{StaticResource PreviewItemRowTemplate}" />
                                </Grid>
                            </Border>

                            <!-- Group: Approved save mappings -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="0">

                                <Grid RowDefinitions="Auto,Auto,Auto">

                                    <Border Grid.Row="0"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <TextBlock Text="Approved save mappings"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="{DynamicResource FontSizeBodyLarge}"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Text="Excluded from this preview"
                                                           IsVisible="{Binding !IncludeApprovedMappings}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="{DynamicResource FontSizeBody}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="Save locations from the approved mapping database, expanded for the selected profiles."
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Padding="10,6"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            IsVisible="{Binding !!MappingItems.Count}">

                                        <ContentControl Content=""
                                                        ContentTemplate="{StaticResource PreviewColumnsHeaderTemplate}" />
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="Files from approved save mappings appear here after a preview."
                                               IsVisible="{Binding !MappingItems.Count}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Margin="12,10" />

                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding MappingItems}"
                                                  ItemTemplate="{StaticResource PreviewItemRowTemplate}" />
                                </Grid>
                            </Border>

                            <!-- Group: Execution results -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="0">

                                <Grid RowDefinitions="Auto,Auto,Auto">

                                    <Border Grid.Row="0"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Execution results"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBodyLarge}"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Text="Exactly what was copied, skipped, or failed during the last copy."
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Padding="10,6"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            IsVisible="{Binding !!ExecutionResults.Count}">

                                        <Grid ColumnDefinitions="2*,2*,80,130,*"
                                              ColumnSpacing="10">

                                            <TextBlock Grid.Column="0"
                                                       Text="Source file"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="Bold" />

                                            <TextBlock Grid.Column="1"
                                                       Text="Target file"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="Bold" />

                                            <TextBlock Grid.Column="2"
                                                       Text="Size"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="Bold" />

                                            <TextBlock Grid.Column="3"
                                                       Text="Status"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="Bold" />

                                            <TextBlock Grid.Column="4"
                                                       Text="Details"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="Bold" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="File-by-file results appear here after a copy."
                                               IsVisible="{Binding !ExecutionResults.Count}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Margin="12,10" />

                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding ExecutionResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SaveTransferItemResultRowViewModel">
                                                <Border Padding="10,6"
                                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                        BorderThickness="0,0,0,1">

                                                    <StackPanel Spacing="3">
                                                        <Grid ColumnDefinitions="2*,2*,80,130,*"
                                                              ColumnSpacing="10">

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SourceFile}"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       ToolTip.Tip="{Binding SourceFile}"
                                                                       FontSize="{DynamicResource FontSizeBody}"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding TargetFile}"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       ToolTip.Tip="{Binding TargetFile}"
                                                                       FontSize="{DynamicResource FontSizeBody}"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SizeDisplay}"
                                                                       FontSize="{DynamicResource FontSizeBody}"
                                                                       Foreground="{DynamicResource MutedTextBrush}" />

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Status}"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                       FontSize="{DynamicResource FontSizeBody}"
                                                                       FontWeight="SemiBold" />

                                                            <TextBlock Grid.Column="4"
                                                                       Text="{Binding Error}"
                                                                       Foreground="{DynamicResource WarningBrush}"
                                                                       FontSize="{DynamicResource FontSizeBody}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>

                                                        <TextBlock Text="{Binding BackupDisplay}"
                                                                   IsVisible="{Binding HasBackup}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="{DynamicResource FontSizeMicro}"
                                                                   ToolTip.Tip="{Binding BackupFile}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>
            </wsp:WorkspacePanel>
        </wsp:WorkspaceSurface.Panels>
    </wsp:WorkspaceSurface>
</UserControl>
