<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             xmlns:wsp="using:GameSaves.App.Views.Workspace"
             x:Class="GameSaves.App.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel"
             Background="{DynamicResource PageBackgroundBrush}">

    <wsp:WorkspaceSurface Layout="{Binding Workspace}"
                          MaxWidth="1100"
                          Margin="0,12,24,14">
        <wsp:WorkspaceSurface.Panels>

            <wsp:WorkspacePanel PanelKey="profiles.header"
                                Classes="pageHeader"
                                Title="Profiles"
                                Subtitle="Source and target profiles for save transfers."
                                CanHide="False">
                <wsp:WorkspacePanel.HeaderActions>
                    <!-- Settings can drop the Scan action from this page; the rail
                         action always remains, so scanning is never unreachable. -->
                    <Panel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Settings.ShowScanOnProfiles}">
                        <Button Content="Scan Steam library"
                                IsVisible="{Binding HasProfiles}"
                                Command="{Binding RefreshProfilesCommand}"
                                VerticalAlignment="Center" />
                    </Panel>
                </wsp:WorkspacePanel.HeaderActions>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextWrapping="Wrap" />
            </wsp:WorkspacePanel>

            <!-- The one condition that makes profile detection impossible. The
                 whole card is conditional, so the condition lives on the panel. -->
            <wsp:WorkspacePanel PanelKey="profiles.steamMissing"
                                Classes="warning"
                                Glyph="&#xE7BA;"
                                Title="Steam was not found on this computer"
                                Subtitle="Profile detection needs a Steam installation. Install Steam, or scan again if it was just installed."
                                CanHide="False"
                                CanCollapse="False"
                                CanFloat="False"
                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSteamMissing}" />

            <!-- Source and target sit side by side because both declare a
                 preferred width and the top region flows. That region scrolls
                 on its own, so neither card carries its own scroller. -->
            <wsp:WorkspacePanel PanelKey="profiles.sourceProfile"
                                Title="Source profile"
                                PreferredWidth="380">
                <StackPanel Spacing="10">
                    <Panel>
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SourceProfile}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SteamProfileRowViewModel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding UserDataPath}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Opacity="0.65" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Select a profile"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   Margin="12,0,32,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   IsVisible="{Binding SourceProfile, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Panel>

                    <TextBlock Text="{Binding SourcePath}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <Button Content="Open source folder"
                            Command="{Binding OpenSourceFolderCommand}"
                            IsEnabled="{Binding SourceProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Width="170" />
                </StackPanel>
            </wsp:WorkspacePanel>

            <wsp:WorkspacePanel PanelKey="profiles.targetProfile"
                                Title="Target profile"
                                PreferredWidth="380">
                <StackPanel Spacing="10">
                    <Panel>
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding TargetProfile}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SteamProfileRowViewModel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding UserDataPath}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Opacity="0.65" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Select a profile"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   Margin="12,0,32,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   IsVisible="{Binding TargetProfile, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Panel>

                    <TextBlock Text="{Binding TargetPath}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <Button Content="Open target folder"
                            Command="{Binding OpenTargetFolderCommand}"
                            IsEnabled="{Binding TargetProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Width="170" />
                </StackPanel>
            </wsp:WorkspacePanel>

            <wsp:WorkspacePanel PanelKey="profiles.detected"
                                Classes="table"
                                Title="Detected profiles"
                                MinPanelHeight="200">

                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- One of these two is always visible, so the section always
                         carries a description. They stay in the body rather than
                         becoming the panel's Subtitle because Subtitle is a single
                         string and this description is conditional.
                         See Round 42 P2 on card-header idioms. -->
                    <!-- This panel is Classes="table", so its body has no
                         horizontal inset and the row rules reach the card edge.
                         Prose in that body has to bring its own. -->
                    <StackPanel Grid.Row="0" Spacing="2" Margin="14,0,14,10">
                        <TextBlock Text="Steam accounts found in this installation."
                                   IsVisible="{Binding !HasProfiles}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeSubtitle}" />

                        <TextBlock Text="{Binding SelectionWarning}"
                                   IsVisible="{Binding HasProfiles}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeSubtitle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="12"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding HasProfiles}">

                        <Grid ColumnDefinitions="180,*,130,130"
                              ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="Account ID"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="1"
                                       Text="Userdata path"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="2"
                                       Text="App folders"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="3"
                                       Text="Current"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  IsVisible="{Binding HasProfiles}">
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SteamProfileRowViewModel">
                                    <Border Padding="12"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="0,0,0,1">

                                        <Grid ColumnDefinitions="180,*,130,130"
                                              ColumnSpacing="12">

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding AccountId}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding UserDataPath}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AppFolderCount}"
                                                       Foreground="{DynamicResource AccentBrush}" />

                                            <!-- "Current" names the profile Steam is
                                                 actually signed into: active state, so it
                                                 resolves through the accent instead of
                                                 reading as muted body text. Two blocks
                                                 rather than one class-styled block,
                                                 because a floated panel leaves this
                                                 view's style scope. -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CurrentUserText}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       IsVisible="{Binding IsCurrentUser}" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CurrentUserText}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       IsVisible="{Binding !IsCurrentUser}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state: shown only when detection found no profiles
                         and no refresh is in progress. -->
                    <views:EmptyState Grid.Row="2"
                                      Glyph="&#xE716;"
                                      Title="No Steam profiles found"
                                      Message="Make sure Steam is installed and signed in, then scan again.">
                        <views:EmptyState.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasProfiles" />
                                <Binding Path="!IsLoading" />
                            </MultiBinding>
                        </views:EmptyState.IsVisible>
                        <views:EmptyState.ActionContent>
                            <Button Content="Scan Steam library"
                                    Classes="primary"
                                    Command="{Binding RefreshProfilesCommand}" />
                        </views:EmptyState.ActionContent>
                    </views:EmptyState>
                </Grid>
            </wsp:WorkspacePanel>

        </wsp:WorkspaceSurface.Panels>
    </wsp:WorkspaceSurface>
</UserControl>
