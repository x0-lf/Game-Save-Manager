<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             x:Class="GameSaves.App.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel"
             Background="{DynamicResource PageBackgroundBrush}">


    <ScrollViewer Classes="pageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid RowSpacing="0"
          Margin="0,12,24,14"
          MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MinHeight="120" MaxHeight="420" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10"
                Margin="0,0,0,10">

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">

                <StackPanel Grid.Column="0"
                            Spacing="2">
                    <TextBlock Text="Profiles" Classes="h1" />

                    <TextBlock Text="Source and target profiles for save transfers."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Scan Steam library"
                        IsVisible="{Binding HasProfiles}"
                        Command="{Binding RefreshProfilesCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,10">
            <Border IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSteamMissing}"
                    Background="{DynamicResource WarningTintBrush}"
                    BorderBrush="{DynamicResource WarningEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Grid.Column="0"
                               Text="&#xE7BA;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Steam was not found on this computer"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBodyLarge}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Profile detection needs a Steam installation. Install Steam, or scan again if it was just installed."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   MaxWidth="760"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Source / Target selection (resizable, scrolls when small) -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="16">

            <!-- Source -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="0">

                <ScrollViewer>
                <StackPanel Spacing="10"
                            Margin="16,12">
                    <TextBlock Text="Source profile"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBodyLarge}"
                               FontWeight="SemiBold" />

                    <Panel>
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SourceProfile}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SteamProfileRowViewModel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding UserDataPath}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Select a profile"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               Margin="12,0,32,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               IsVisible="{Binding SourceProfile, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Panel>

                    <TextBlock Text="{Binding SourcePath}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <Button Content="Open source folder"
                            Command="{Binding OpenSourceFolderCommand}"
                            IsEnabled="{Binding SourceProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Width="170" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Target -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="0">

                <ScrollViewer>
                <StackPanel Spacing="10"
                            Margin="16,12">
                    <TextBlock Text="Target profile"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBodyLarge}"
                               FontWeight="SemiBold" />

                    <Panel>
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding TargetProfile}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SteamProfileRowViewModel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding UserDataPath}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Select a profile"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               Margin="12,0,32,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               IsVisible="{Binding TargetProfile, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Panel>

                    <TextBlock Text="{Binding TargetPath}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <Button Content="Open target folder"
                            Command="{Binding OpenTargetFolderCommand}"
                            IsEnabled="{Binding TargetProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Width="170" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3"
                      Height="8"
                      Margin="0,1"
                      Background="Transparent"
                      ResizeDirection="Rows" />

        <!-- Profiles list -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="0">

            <Grid RowDefinitions="Auto,Auto,*">

                <Border Grid.Row="0"
                        Padding="12,8"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,0,0,1">

                    <StackPanel Spacing="2">
                        <TextBlock Text="Detected profiles"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBodyLarge}"
                                   FontWeight="SemiBold" />

                        <!-- One of these two is always visible, so the band always
                             carries a subtitle. The house rule is: a header with a
                             subtitle gets a ruled band, a title-only header does not.
                             This card had the band but a conditional subtitle, so it
                             collapsed to a title-only band whenever no profile was
                             found. See Round 42 P2 on card-header idioms. -->
                        <TextBlock Text="Steam accounts found in this installation."
                                   IsVisible="{Binding !HasProfiles}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeSubtitle}" />

                        <TextBlock Text="{Binding SelectionWarning}"
                                   IsVisible="{Binding HasProfiles}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeSubtitle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Padding="12"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,0,0,1"
                        IsVisible="{Binding HasProfiles}">

                    <Grid ColumnDefinitions="180,*,130,130"
                          ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="Account ID"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="Bold" />

                        <TextBlock Grid.Column="1"
                                   Text="Userdata path"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="Bold" />

                        <TextBlock Grid.Column="2"
                                   Text="App folders"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="Bold" />

                        <TextBlock Grid.Column="3"
                                   Text="Current"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="Bold" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding HasProfiles}">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SteamProfileRowViewModel">
                                <Border Padding="12"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1">

                                    <Grid ColumnDefinitions="180,*,130,130"
                                          ColumnSpacing="12">

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding AccountId}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UserDataPath}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AppFolderCount}"
                                                   Foreground="{DynamicResource AccentBrush}" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CurrentUserText}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state: shown only when detection found no profiles
                     and no refresh is in progress. -->
                <views:EmptyState Grid.Row="2"
                                  Glyph="&#xE716;"
                                  Title="No Steam profiles found"
                                  Message="Make sure Steam is installed and signed in, then scan again.">
                    <views:EmptyState.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!HasProfiles" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </views:EmptyState.IsVisible>
                    <views:EmptyState.ActionContent>
                        <Button Content="Scan Steam library"
                                Classes="primary"
                                Command="{Binding RefreshProfilesCommand}" />
                    </views:EmptyState.ActionContent>
                </views:EmptyState>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
