<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameSaves.App.ViewModels"
        xmlns:views="using:GameSaves.App.Views"
        x:Class="GameSaves.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Game Save Manager"
        Width="1200"
        Height="760"
        MinWidth="800"
        MinHeight="600"
        Background="{DynamicResource PageBackgroundBrush}">

	<!-- Keyboard shortcuts. Ctrl+1..9 jump to the rail's original tab order
	     (a detached tab surfaces its floating window; a hidden tab's slot
	     does nothing, so slot numbers never shift meaning); Ctrl+Comma opens
	     Settings. Gestures live here so they stay reviewable; the commands
	     are attached in code-behind, where the navigation control and the
	     detach coordinator live. Ctrl+D1 is the top-row digit. -->
	<Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+D1" CommandParameter="1" />
		<KeyBinding Gesture="Ctrl+D2" CommandParameter="2" />
		<KeyBinding Gesture="Ctrl+D3" CommandParameter="3" />
		<KeyBinding Gesture="Ctrl+D4" CommandParameter="4" />
		<KeyBinding Gesture="Ctrl+D5" CommandParameter="5" />
		<KeyBinding Gesture="Ctrl+D6" CommandParameter="6" />
		<KeyBinding Gesture="Ctrl+D7" CommandParameter="7" />
		<KeyBinding Gesture="Ctrl+D8" CommandParameter="8" />
		<KeyBinding Gesture="Ctrl+D9" CommandParameter="9" />
		<KeyBinding Gesture="Ctrl+OemComma" />
	</Window.KeyBindings>

	<Window.Styles>
		<!-- Navigation rail: compact icon+label rows on the left edge. -->
		<Style Selector="TabControl#MainNavigation">
			<Setter Property="Padding" Value="16,10,16,16" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem">
			<!-- Stretch so each header's [glyph | label | detach] grid fills
			     the rail: the detach buttons then share one right edge
			     instead of trailing their own label's width. -->
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
			<Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="Margin" Value="8,1" />
			<!-- Fixed height, not MinHeight: the Fluent selected state renders
			     the pill taller, which reflowed the whole rail by 2-4px on
			     every view change (critic round 27). -->
			<Setter Property="Height" Value="38" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem /template/ Border#PART_LayoutRoot">
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem:selected /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
		</Style>

		<!-- Below 900px the rail collapses to icons; the window toggles the
		     compactNav class from code-behind. -->
		<Style Selector="Window.compactNav TabControl#MainNavigation TabItem TextBlock.navLabel">
			<Setter Property="IsVisible" Value="False" />
		</Style>

		<!-- Collapsed rail (the Settings collapse toggle): a glyph-only strip
		     roughly 48px wide. The detach button hides with the label —
		     detach stays reachable through the tab context menu — and the
		     header ToolTips keep carrying the tab names. Declared after the
		     compactNav styles so a window that is both narrow and collapsed
		     takes the narrower collapsed geometry. -->
		<Style Selector="Window.railCollapsed TabControl#MainNavigation">
			<Setter Property="Padding" Value="2,10,2,10" />
		</Style>
		<Style Selector="Window.railCollapsed TabControl#MainNavigation TabItem">
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="Margin" Value="4,1" />
		</Style>
		<Style Selector="Window.railCollapsed TabControl#MainNavigation TabItem TextBlock.navLabel">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="Window.railCollapsed TabControl#MainNavigation TabItem Button.navDetach">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem TextBlock.navGlyph">
			<Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem TextBlock.navLabel">
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- Detach button styles moved to Themes/Controls.axaml so the base
		     chrome and the :focus-visible ring (which rebalances padding to
		     keep the box pixel-stable) live in one place. -->

		<!-- Dashboard stat values: neutral at zero, coloured only when the
		     number carries real state. -->
		<Style Selector="TextBlock.statValue">
			<Setter Property="FontSize" Value="{DynamicResource FontSizeStat}" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		</Style>
		<Style Selector="TextBlock.statValue.accent">
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style Selector="TextBlock.statValue.good">
			<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
		</Style>
		<Style Selector="TextBlock.statValue.warn">
			<Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
		</Style>
		<Style Selector="TextBlock.statValue.bad">
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*">

		<!-- Slim application header: identity on the left, settings on the
		     right. Section-scoped actions live inside each section, never
		     here. -->
		<Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">

			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

				<StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
					<TextBlock Text="&#xE7FC;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrandBrush}" />
					<TextBlock Text="Game Save Manager"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="{DynamicResource FontSizeSubheading}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
				</StackPanel>

					<Button Grid.Column="1"
                        x:Name="SettingsButton"
                        Classes="iconButton"
                        Click="OnSettingsClicked"
                        AutomationProperties.Name="Settings"
                        ToolTip.Tip="Settings (Ctrl+Comma)">
						<TextBlock Text="&#xE713;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
					</Button>
			</Grid>
		</Border>

		<!-- Navigation rail plus content. The TabControl keeps every section
		     alive so section state survives navigation, exactly as the old
		     top tab strip did. The expand button shares the rail's column
		     and is visible only while the rail is collapsed (it is bound to
		     the collapse state), so the default layout renders unchanged. -->
		<Grid Grid.Row="1" RowDefinitions="Auto,*">

			<Button x:Name="ExpandNavigationButton"
			        Grid.Row="0"
			        Classes="iconButton"
			        Click="OnExpandNavigationClicked"
			        IsVisible="{Binding Settings.RailCollapsed}"
			        HorizontalAlignment="Left"
			        Margin="10,8,0,0"
			        AutomationProperties.Name="Expand navigation"
			        ToolTip.Tip="Show the navigation labels again">
				<TextBlock Text="&#xE700;"
				           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
				           FontSize="16"
				           Foreground="{DynamicResource SecondaryTextBrush}" />
			</Button>

			<TabControl Grid.Row="1"
	                    x:Name="MainNavigation"
	                    TabStripPlacement="Left">

			<TabItem AutomationProperties.Name="Dashboard">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Dashboard (Ctrl+1)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE80F;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Dashboard" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Dashboard"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<ScrollViewer Classes="pageScroll" VerticalContentAlignment="Stretch">
					<StackPanel Spacing="10" MaxWidth="1100" Margin="0,12,24,14">

						<Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,10">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
								<StackPanel Grid.Column="0" Spacing="2">
									<TextBlock Text="Dashboard" Classes="h1" />
									<TextBlock Text="Your Steam library and save mappings at a glance."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               TextWrapping="Wrap" />
									<TextBlock Text="{Binding StatusMessage}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               TextWrapping="Wrap" />
								</StackPanel>
								<Button Grid.Column="1"
                                        Content="Scan Steam library"
                                        Command="{Binding RefreshCommand}"
                                        IsVisible="{Binding !IsSteamMissing}"
                                        VerticalAlignment="Center" />
							</Grid>
						</Border>

						<!-- The one condition that makes the whole app inert
						     gets the most designed treatment on the page. -->
						<Border IsVisible="{Binding IsSteamMissing}"
                                Background="{DynamicResource WarningTintBrush}"
                                BorderBrush="{DynamicResource WarningEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,8">
							<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
								<TextBlock Grid.Column="0"
                                           Text="&#xE7BA;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource WarningBrush}" />
								<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
									<TextBlock Text="Steam was not found on this computer"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeBodyLarge}"
                                               FontWeight="SemiBold" />
									<TextBlock Text="Game discovery, profiles and backups need a Steam installation. Install Steam, or scan again if it was just installed."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               MaxWidth="760"
                                               HorizontalAlignment="Left"
                                               TextWrapping="Wrap" />
								</StackPanel>
							</Grid>
						</Border>

						<!-- First run with no Steam: a guided path, not a
						     wall of zeros. -->
						<Border IsVisible="{Binding IsSteamMissing}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="18">
							<StackPanel Spacing="14">
								<TextBlock MaxWidth="640" HorizontalAlignment="Left" Text="Get set up"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold" />
								<StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinHeight="32">
										<TextBlock Text="1" Width="22" TextAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="1" Text="Install Steam and sign in." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center" />
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinHeight="32">
										<TextBlock Text="2" Width="22" TextAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="1" Text="Scan to discover your libraries, games and profiles." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center" />
									</Grid>
									<Button Content="Scan Steam library"
                                            Classes="primary"
                                            Command="{Binding RefreshCommand}"
                                            Margin="32,0,0,0"
                                            HorizontalAlignment="Left" />
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinHeight="32">
										<TextBlock Text="3" Width="22" TextAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="1" Text="Create your first backup from the Manual backup section." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center" />
									</Grid>
								</StackPanel>
								<TextBlock Text="Every backup is copy-only: nothing is ever overwritten or deleted."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}" />
							</StackPanel>
						</Border>

						<Grid ColumnDefinitions="*,*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="14"
                              RowSpacing="14"
                              IsVisible="{Binding !IsSteamMissing}">

							<!-- Libraries -->
							<Border Grid.Row="0"
                                    Grid.Column="0"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18">

								<StackPanel Spacing="8">
									<TextBlock Text="Libraries"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               TextWrapping="Wrap" />

									<TextBlock Text="{Binding LibraryCount}"
                                               Classes="statValue"
                                               Classes.accent="{Binding HasLibraries}" />
								</StackPanel>
							</Border>

							<!-- Installed games -->
							<Border Grid.Row="0"
                                    Grid.Column="1"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18">

								<StackPanel Spacing="8">
									<TextBlock Text="Installed games"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               TextWrapping="Wrap" />

									<TextBlock Text="{Binding InstalledGameCount}"
                                               Classes="statValue"
                                               Classes.good="{Binding HasInstalledGames}" />
								</StackPanel>
							</Border>

							<!-- Profiles -->
							<Border Grid.Row="0"
                                    Grid.Column="2"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18">

								<StackPanel Spacing="8">
									<TextBlock Text="Steam profiles"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               TextWrapping="Wrap" />

									<TextBlock Text="{Binding SteamProfileCount}"
                                               Classes="statValue"
                                               Classes.accent="{Binding HasSteamProfiles}" />
								</StackPanel>
							</Border>

							<!-- Approved mappings -->
							<Border Grid.Row="1"
                                    Grid.Column="0"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18">

								<StackPanel Spacing="8">
									<TextBlock Text="Approved mappings"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               TextWrapping="Wrap" />

									<TextBlock Text="{Binding ApprovedMappingCount}"
                                               Classes="statValue"
                                               Classes.good="{Binding HasApprovedMappings}" />
								</StackPanel>
							</Border>

							<!-- Pending mappings -->
							<Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18">

								<StackPanel Spacing="8">
									<TextBlock Text="Pending mappings"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               TextWrapping="Wrap" />

									<TextBlock Text="{Binding PendingMappingCount}"
                                               Classes="statValue"
                                               Classes.warn="{Binding HasPendingMappings}" />
								</StackPanel>
							</Border>

							<!-- NeedsFix mappings -->
							<Border Grid.Row="1"
                                    Grid.Column="2"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18">

								<StackPanel Spacing="8">
									<TextBlock Text="Needs attention"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               TextWrapping="Wrap" />

									<TextBlock Text="{Binding NeedsFixMappingCount}"
                                               Classes="statValue"
                                               Classes.bad="{Binding HasNeedsFixMappings}" />
								</StackPanel>
							</Border>

						</Grid>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem AutomationProperties.Name="Installed games">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Installed games (Ctrl+2)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE7FC;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Installed games" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Installed games"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:InstalledGamesView DataContext="{Binding InstalledGames}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Profiles">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Profiles (Ctrl+3)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE716;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Profiles" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Profiles"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:ProfilesView DataContext="{Binding Profiles}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Transfer preview">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Transfer preview (Ctrl+4)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE8AB;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Transfer preview" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Transfer preview"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:TransferPreviewView DataContext="{Binding TransferPreview}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Manual backup">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Manual backup (Ctrl+5)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE74E;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Manual backup" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Manual backup"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:ManualBackupView DataContext="{Binding ManualBackup}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Backups">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Backups (Ctrl+6)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE8F1;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Backups" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Backups"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:BackupHistoryView DataContext="{Binding BackupHistory}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Sync">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Sync (Ctrl+7)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE895;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Sync" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Sync"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:SyncView DataContext="{Binding Sync}" />
			</TabItem>

			<TabItem AutomationProperties.Name="History">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="History (Ctrl+8)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE81C;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="History" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach History"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:TransferHistoryView DataContext="{Binding TransferHistory}" />
			</TabItem>

			<TabItem x:Name="SettingsTab" AutomationProperties.Name="Settings">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Settings (Ctrl+9)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE713;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Settings" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Settings"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:SettingsView DataContext="{Binding Settings}" />
				</TabItem>
			</TabControl>
		</Grid>
	</Grid>
</Window>
