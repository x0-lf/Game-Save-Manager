<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameSaves.App.ViewModels"
        xmlns:views="using:GameSaves.App.Views"
        xmlns:wsp="using:GameSaves.App.Views.Workspace"
        x:Class="GameSaves.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Game Save Manager"
        Width="1200"
        Height="760"
        MinWidth="800"
        MinHeight="600"
        Background="{DynamicResource PageBackgroundBrush}">

	<!-- Keyboard shortcuts. Ctrl+1..9 jump to the rail's original tab order
	     (a detached tab surfaces its floating window; a hidden tab's slot
	     does nothing, so slot numbers never shift meaning); Ctrl+Comma opens
	     Settings. Gestures live here so they stay reviewable; the commands
	     are attached in code-behind, where the navigation control and the
	     detach coordinator live. Ctrl+D1 is the top-row digit. -->
	<Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+D1" CommandParameter="1" />
		<KeyBinding Gesture="Ctrl+D2" CommandParameter="2" />
		<KeyBinding Gesture="Ctrl+D3" CommandParameter="3" />
		<KeyBinding Gesture="Ctrl+D4" CommandParameter="4" />
		<KeyBinding Gesture="Ctrl+D5" CommandParameter="5" />
		<KeyBinding Gesture="Ctrl+D6" CommandParameter="6" />
		<KeyBinding Gesture="Ctrl+D7" CommandParameter="7" />
		<KeyBinding Gesture="Ctrl+D8" CommandParameter="8" />
		<KeyBinding Gesture="Ctrl+D9" CommandParameter="9" />
		<KeyBinding Gesture="Ctrl+OemComma" />
	</Window.KeyBindings>

	<Window.Styles>
		<!-- Navigation rail: compact icon+label rows on the left edge. -->
		<Style Selector="TabControl#MainNavigation">
			<Setter Property="Padding" Value="16,10,16,16" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem">
			<!-- Stretch so each header's [glyph | label | detach] grid fills
			     the rail: the detach buttons then share one right edge
			     instead of trailing their own label's width. -->
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
			<Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="Margin" Value="8,1" />
			<!-- Fixed height, not MinHeight: the Fluent selected state renders
			     the pill taller, which reflowed the whole rail by 2-4px on
			     every view change (critic round 27). -->
			<Setter Property="Height" Value="38" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem /template/ Border#PART_LayoutRoot">
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
		</Style>
		<!-- The selected section is the app's primary "you are here" marker, so
		     it carries the accent: an accent-tinted fill at the same 0.12 the
		     tables use for a selected row, an accent edge, and accent ink on the
		     glyph and label. Hover keeps the neutral card fill, so hovering an
		     unselected entry can never be mistaken for the current one. -->
		<Style Selector="TabControl#MainNavigation TabItem:selected /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{DynamicResource AccentSelectionTintBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>
		<!-- The label takes the primary ink rather than the accent: accent ink
		     on a 12% accent tint measured below WCAG AA in the light theme on
		     three of the five accents. The accent still carries the selection
		     through the tinted fill, the accent edge and the selected pipe,
		     which is enough signal without putting the text at risk. -->
		<Style Selector="TabControl#MainNavigation TabItem:selected">
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>

		<!-- Below 900px the rail collapses to icons; the window toggles the
		     compactNav class from code-behind. -->
		<Style Selector="Window.compactNav TabControl#MainNavigation TabItem TextBlock.navLabel">
			<Setter Property="IsVisible" Value="False" />
		</Style>

		<!-- Collapsed rail (the Settings collapse toggle): a glyph-only strip
		     roughly 48px wide. The detach button hides with the label —
		     detach stays reachable through the tab context menu — and the
		     header ToolTips keep carrying the tab names. Declared after the
		     compactNav styles so a window that is both narrow and collapsed
		     takes the narrower collapsed geometry. -->
		<Style Selector="Window.railCollapsed TabControl#MainNavigation">
			<Setter Property="Padding" Value="2,10,2,10" />
		</Style>
		<Style Selector="Window.railCollapsed TabControl#MainNavigation TabItem">
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="Margin" Value="4,1" />
		</Style>
		<Style Selector="Window.railCollapsed TabControl#MainNavigation TabItem TextBlock.navLabel">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="Window.railCollapsed TabControl#MainNavigation TabItem Button.navDetach">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<!-- The rail chrome follows the same collapse rule as the tab headers:
		     glyphs stay, labels go. The collapse toggle itself never hides —
		     it is the only way back. -->
		<Style Selector="Window.railCollapsed StackPanel#RailChrome TextBlock.railChromeLabel">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="Window.compactNav StackPanel#RailChrome TextBlock.railChromeLabel">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<!-- On a top rail the chrome sits on the same band as the tabs rather
		     than in a strip of its own, so the row keeps the app's header
		     rhythm instead of adding a second one. -->
		<Style Selector="Window.railTop StackPanel#RailChrome">
			<Setter Property="Margin" Value="16,6,16,0" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem TextBlock.navGlyph">
			<Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TabControl#MainNavigation TabItem TextBlock.navLabel">
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- Detach button styles moved to Themes/Controls.axaml so the base
		     chrome and the :focus-visible ring (which rebalances padding to
		     keep the box pixel-stable) live in one place. -->

		<!-- Dashboard stat values: neutral at zero, coloured only when the
		     number carries real state. -->
		<Style Selector="TextBlock.statValue">
			<Setter Property="FontSize" Value="{DynamicResource FontSizeStat}" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		</Style>
		<Style Selector="TextBlock.statValue.accent">
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style Selector="TextBlock.statValue.good">
			<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
		</Style>
		<Style Selector="TextBlock.statValue.warn">
			<Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
		</Style>
		<Style Selector="TextBlock.statValue.bad">
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*">

		<!-- Slim application header: identity on the left, settings on the
		     right. Section-scoped actions live inside each section, never
		     here. -->
		<Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">

			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

				<StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
					<TextBlock Text="&#xE7FC;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrandBrush}" />
					<TextBlock Text="Game Save Manager"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="{DynamicResource FontSizeSubheading}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
				</StackPanel>

					<Button Grid.Column="1"
                        x:Name="SettingsButton"
                        Classes="iconButton"
                        Click="OnSettingsClicked"
                        AutomationProperties.Name="Settings"
                        ToolTip.Tip="Settings (Ctrl+Comma)">
						<TextBlock Text="&#xE713;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
					</Button>
			</Grid>
		</Border>

		<!-- The rail is one docked surface: its action row comes first and its
		     tab headers second. Left and right rails therefore extend upward
		     around the actions; the top rail becomes a deliberate two-row menu.
		     Selected page content remains outside this opaque host so Acrylic or
		     Mica can still own the content surface. -->
		<TabControl Grid.Row="1"
		            x:Name="MainNavigation"
		            TabStripPlacement="Left">
			<TabControl.Template>
				<ControlTemplate>
					<Border BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}"
					        CornerRadius="{TemplateBinding CornerRadius}"
					        Background="{TemplateBinding Background}"
					        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
					        VerticalAlignment="{TemplateBinding VerticalAlignment}">
						<DockPanel>
							<Border x:Name="PART_NavigationRail"
							        Background="{DynamicResource NavigationSurfaceBrush}"
							        DockPanel.Dock="{TemplateBinding TabStripPlacement}">
								<StackPanel Orientation="Vertical">
									<ContentPresenter x:Name="PART_RailChromeHost"
									                  Content="{TemplateBinding Tag}" />
									<ItemsPresenter x:Name="PART_ItemsPresenter"
									                ItemsPanel="{TemplateBinding ItemsPanel}" />
								</StackPanel>
							</Border>
							<Panel ClipToBounds="True">
								<ContentPresenter x:Name="PART_SelectedContentHost2"
								                  Margin="{TemplateBinding Padding}"
								                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
								                  IsVisible="False" />
								<ContentPresenter x:Name="PART_SelectedContentHost"
								                  Margin="{TemplateBinding Padding}"
								                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
							</Panel>
						</DockPanel>
					</Border>
				</ControlTemplate>
			</TabControl.Template>

			<TabControl.Tag>
				<!-- Page-sensitive actions stay inside the shared rail host. Labels
				     still collapse to icons through the existing window classes. -->
				<StackPanel x:Name="RailChrome"
				            Orientation="Horizontal"
				            Spacing="2"
				            Margin="10,8,10,0">

				<ToggleButton x:Name="CollapseNavigationButton"
				              Classes="railChrome"
				              IsChecked="{Binding Settings.RailCollapsed, Mode=TwoWay}"
				              AutomationProperties.Name="Collapse the navigation rail"
				              ToolTip.Tip="Collapse or expand the navigation rail">
					<TextBlock Text="&#xE700;" Classes="railChromeGlyph" />
				</ToggleButton>

				<!-- Context sensitive: it runs the active page's own refresh
				     command, and carries that page's wording. The view model
				     owns the whole page-to-command mapping; nothing here knows
				     what any page refreshes. Absent on a page with no refresh,
				     so Settings shows no gap rather than a dead button. -->
				<Button x:Name="RailScanButton"
				        Classes="railChrome"
				        Command="{Binding RailScanCommand}"
				        IsVisible="{Binding IsRailScanVisible}"
				        AutomationProperties.Name="{Binding RailScanDescription}"
				        ToolTip.Tip="{Binding RailScanDescription}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<TextBlock Text="&#xE72C;" Classes="railChromeGlyph railAccentGlyph" />
						<TextBlock Text="{Binding RailScanLabel}"
						           Classes="railChromeLabel"
						           Foreground="{DynamicResource AccentBrush}"
						           VerticalAlignment="Center" />
					</StackPanel>
				</Button>

				<!-- The page's own layout menu. It belongs on the rail rather
				     than on the page because a page whose sections are all
				     hidden has no panel headers left to carry it, and because
				     the rail keeps it reachable when docked left, right or
				     top and while collapsed to glyphs. Code-behind hides it
				     on pages that have no configurable layout. -->
				<Button x:Name="RailLayoutButton"
				        Classes="railChrome"
				        Click="OnRailLayoutClicked"
				        AutomationProperties.Name="Page layout"
				        AutomationProperties.HelpText="Show hidden sections on this page, or reset the page layout"
				        ToolTip.Tip="Page layout — show hidden sections or reset this page">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<TextBlock Text="&#xE8A9;" Classes="railChromeGlyph" />
						<TextBlock Text="Layout"
						           Classes="railChromeLabel"
						           Foreground="{DynamicResource SecondaryTextBrush}"
						           VerticalAlignment="Center" />
					</StackPanel>
				</Button>
				</StackPanel>
			</TabControl.Tag>

			<TabItem AutomationProperties.Name="Dashboard">
				<TabItem.ContextMenu>
					<ContextMenu Opening="OnTabContextMenuOpening">
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
						          <Separator />
						          <!-- Filled in when the menu opens, from the section catalog for
						               this page. Right-click reaches it wherever the rail sits. -->
						          <MenuItem Header="Sections"
						                    Tag="sections"
						                    AutomationProperties.Name="Show or hide sections on this page" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Dashboard (Ctrl+1)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE80F;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Dashboard" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Dashboard"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<wsp:WorkspaceSurface Layout="{Binding Workspace}"
				                      MaxWidth="1100"
				                      Margin="0,12,24,14">
					<wsp:WorkspaceSurface.Panels>

						<wsp:WorkspacePanel PanelKey="dashboard.intro"
						                    Classes="pageHeader"
						                    Title="Dashboard"
						                    Subtitle="Your Steam library and save mappings at a glance."
						                    CanHide="False"
						                    MinPanelWidth="320">
							<wsp:WorkspacePanel.HeaderActions>
								<!-- Settings can drop the Scan action from this page. The
								     rail action and the guided first-run path below always
								     keep a way to scan, so it can never be turned off
								     everywhere at once. -->
								<Panel IsVisible="{Binding Settings.ShowScanOnDashboard}">
									<Button Content="Scan Steam library"
									        Command="{Binding RefreshCommand}"
									        IsVisible="{Binding !IsSteamMissing}"
									        VerticalAlignment="Center" />
								</Panel>
							</wsp:WorkspacePanel.HeaderActions>
							<TextBlock Text="{Binding StatusMessage}"
							           Foreground="{DynamicResource MutedTextBrush}"
							           FontSize="{DynamicResource FontSizeBody}"
							           TextWrapping="Wrap" />
						</wsp:WorkspacePanel>

						<!-- The one condition that makes the whole app inert
						     gets the most designed treatment on the page. -->
						<wsp:WorkspacePanel PanelKey="dashboard.steamMissing"
						                    Classes="warning"
						                    Glyph="&#xE7BA;"
						                    Title="Steam was not found on this computer"
						                    Subtitle="Game discovery, profiles and backups need a Steam installation. Install Steam, or scan again if it was just installed."
						                    CanCollapse="False"
						                    CanFloat="False"
						                    IsVisible="{Binding IsSteamMissing}"
						                    MinPanelWidth="320" />

						<!-- First run with no Steam: a guided path, not a
						     wall of zeros. -->
						<wsp:WorkspacePanel PanelKey="dashboard.getSetUp"
						                    Title="Get set up"
						                    IsVisible="{Binding IsSteamMissing}"
						                    MinPanelWidth="320">
							<StackPanel Spacing="14">
								<StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinHeight="32">
										<TextBlock Text="1" Width="22" TextAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="1" Text="Install Steam and sign in." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center" />
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinHeight="32">
										<TextBlock Text="2" Width="22" TextAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="1" Text="Scan to discover your libraries, games and profiles." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center" />
									</Grid>
									<Button Content="Scan Steam library"
									        Classes="primary"
									        Command="{Binding RefreshCommand}"
									        Margin="32,0,0,0"
									        HorizontalAlignment="Left" />
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinHeight="32">
										<TextBlock Text="3" Width="22" TextAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="1" Text="Create your first backup from the Manual backup section." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center" />
									</Grid>
								</StackPanel>
								<TextBlock Text="Every backup is copy-only: nothing is ever overwritten or deleted."
								           Foreground="{DynamicResource SecondaryTextBrush}"
								           FontSize="{DynamicResource FontSizeBody}" />
							</StackPanel>
						</wsp:WorkspacePanel>

						<!-- The six stat sections. Each keeps the quiet label
						     idiom and flows three across, exactly as the fixed
						     grid did, and each is independently movable. -->
						<wsp:WorkspacePanel PanelKey="dashboard.libraries"
						                    Classes="quiet"
						                    Title="Libraries"
						                    PreferredWidth="300"
						                    MinPanelWidth="200"
						                    IsVisible="{Binding !IsSteamMissing}">
							<TextBlock Text="{Binding LibraryCount}"
							           Classes="statValue"
							           Classes.accent="{Binding HasLibraries}" />
						</wsp:WorkspacePanel>

						<wsp:WorkspacePanel PanelKey="dashboard.installedGames"
						                    Classes="quiet"
						                    Title="Installed games"
						                    PreferredWidth="300"
						                    MinPanelWidth="200"
						                    IsVisible="{Binding !IsSteamMissing}">
							<TextBlock Text="{Binding InstalledGameCount}"
							           Classes="statValue"
							           Classes.good="{Binding HasInstalledGames}" />
						</wsp:WorkspacePanel>

						<wsp:WorkspacePanel PanelKey="dashboard.steamProfiles"
						                    Classes="quiet"
						                    Title="Steam profiles"
						                    PreferredWidth="300"
						                    MinPanelWidth="200"
						                    IsVisible="{Binding !IsSteamMissing}">
							<TextBlock Text="{Binding SteamProfileCount}"
							           Classes="statValue"
							           Classes.accent="{Binding HasSteamProfiles}" />
						</wsp:WorkspacePanel>

						<wsp:WorkspacePanel PanelKey="dashboard.approvedMappings"
						                    Classes="quiet"
						                    Title="Approved mappings"
						                    PreferredWidth="300"
						                    MinPanelWidth="200"
						                    IsVisible="{Binding !IsSteamMissing}">
							<TextBlock Text="{Binding ApprovedMappingCount}"
							           Classes="statValue"
							           Classes.good="{Binding HasApprovedMappings}" />
						</wsp:WorkspacePanel>

						<wsp:WorkspacePanel PanelKey="dashboard.pendingMappings"
						                    Classes="quiet"
						                    Title="Pending mappings"
						                    PreferredWidth="300"
						                    MinPanelWidth="200"
						                    IsVisible="{Binding !IsSteamMissing}">
							<TextBlock Text="{Binding PendingMappingCount}"
							           Classes="statValue"
							           Classes.warn="{Binding HasPendingMappings}" />
						</wsp:WorkspacePanel>

						<wsp:WorkspacePanel PanelKey="dashboard.needsAttention"
						                    Classes="quiet"
						                    Title="Needs attention"
						                    PreferredWidth="300"
						                    MinPanelWidth="200"
						                    IsVisible="{Binding !IsSteamMissing}">
							<TextBlock Text="{Binding NeedsFixMappingCount}"
							           Classes="statValue"
							           Classes.bad="{Binding HasNeedsFixMappings}" />
						</wsp:WorkspacePanel>

					</wsp:WorkspaceSurface.Panels>
				</wsp:WorkspaceSurface>
			</TabItem>

			<TabItem AutomationProperties.Name="Installed games">
				<TabItem.ContextMenu>
					<ContextMenu Opening="OnTabContextMenuOpening">
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
						          <Separator />
						          <!-- Filled in when the menu opens, from the section catalog for
						               this page. Right-click reaches it wherever the rail sits. -->
						          <MenuItem Header="Sections"
						                    Tag="sections"
						                    AutomationProperties.Name="Show or hide sections on this page" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Installed games (Ctrl+2)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE7FC;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Installed games" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Installed games"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:InstalledGamesView DataContext="{Binding InstalledGames}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Profiles">
				<TabItem.ContextMenu>
					<ContextMenu Opening="OnTabContextMenuOpening">
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
						          <Separator />
						          <!-- Filled in when the menu opens, from the section catalog for
						               this page. Right-click reaches it wherever the rail sits. -->
						          <MenuItem Header="Sections"
						                    Tag="sections"
						                    AutomationProperties.Name="Show or hide sections on this page" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Profiles (Ctrl+3)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE716;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Profiles" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Profiles"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:ProfilesView DataContext="{Binding Profiles}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Transfer profiles">
				<TabItem.ContextMenu>
					<ContextMenu Opening="OnTabContextMenuOpening">
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
						          <Separator />
						          <!-- Filled in when the menu opens, from the section catalog for
						               this page. Right-click reaches it wherever the rail sits. -->
						          <MenuItem Header="Sections"
						                    Tag="sections"
						                    AutomationProperties.Name="Show or hide sections on this page" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Transfer profiles (Ctrl+4)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE8AB;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Transfer profiles" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Transfer profiles"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:TransferPreviewView DataContext="{Binding TransferPreview}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Manual backup">
				<TabItem.ContextMenu>
					<ContextMenu Opening="OnTabContextMenuOpening">
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
						          <Separator />
						          <!-- Filled in when the menu opens, from the section catalog for
						               this page. Right-click reaches it wherever the rail sits. -->
						          <MenuItem Header="Sections"
						                    Tag="sections"
						                    AutomationProperties.Name="Show or hide sections on this page" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Manual backup (Ctrl+5)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE74E;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Manual backup" />
						<Button Grid.Column="2" Classes="navDetach"
						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Manual backup"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:ManualBackupView DataContext="{Binding ManualBackup}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Backups">
				<TabItem.ContextMenu>
					<ContextMenu Opening="OnTabContextMenuOpening">
						<MenuItem Header="Detach tab"
						          Click="OnTabDetachMenuClicked"
						          AutomationProperties.Name="Detach tab" />
						          <Separator />
						          <!-- Filled in when the menu opens, from the section catalog for
						               this page. Right-click reaches it wherever the rail sits. -->
						          <MenuItem Header="Sections"
						                    Tag="sections"
						                    AutomationProperties.Name="Show or hide sections on this page" />
					</ContextMenu>
				</TabItem.ContextMenu>
				<TabItem.Header>
					<Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="Backups (Ctrl+6)">
						<TextBlock Grid.Column="0" Classes="navGlyph" Text="&#xE8F1;" Margin="0,0,10,0" />
						<TextBlock Grid.Column="1" Classes="navLabel" Text="Backups" />
