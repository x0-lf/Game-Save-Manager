						        Click="OnTabDetachClicked"
        AutomationProperties.Name="Detach Backups"
							        AutomationProperties.HelpText="Detaches this tab into a separate window; close the window to reattach"
							        ToolTip.Tip="Move this tab to its own window">
							<TextBlock Text="&#xE8A7;" />
						</Button>
					</Grid>
				</TabItem.Header>
				<views:BackupHistoryView DataContext="{Binding BackupHistory}" />
			</TabItem>

			<TabItem AutomationProperties.Name="Sync">
