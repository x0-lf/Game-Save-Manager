<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameSaves.App.Views.EmptyState">

    <!-- The shared empty-state pattern: icon, one-line title, short
         explanation, optional call-to-action. Views overlay this on any
         region whose backing collection is empty, so a first-run user sees
         guidance instead of column headers floating over a void. -->
    <!-- 12px vertical margin, not 24: in the tightest 800x600 pane the full
         stack barely fits, and a taller footprint pushes the call-to-action
         out of the clipped pane entirely (critic round 28). -->
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="10"
                Margin="24,12"
                MaxWidth="460">

        <Border Width="88"
                Height="88"
                CornerRadius="44"
                HorizontalAlignment="Center"
                Background="{DynamicResource EmptyStateCircleBrush}">
            <TextBlock x:Name="GlyphText"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </Border>

        <TextBlock x:Name="TitleText"
                   FontSize="{DynamicResource FontSizeSubheading}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryTextBrush}" />

        <!-- Two lines are reserved for the caption. The stack is centred, so a
             one-line caption made the block shorter and pushed its 88px disc
             up; two empty states side by side in one row then showed their
             discs 7px apart. Reserving the taller case keeps every block the
             same height, so the discs align by construction.
             ponytail: a fixed 28px reserve, not a measured two-line box;
             revisit if text scaling changes the body line height.
             See Round 42 P1-1. -->
        <TextBlock x:Name="MessageText"
                   FontSize="{DynamicResource FontSizeBody}"
                   MinHeight="28"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <ContentPresenter x:Name="ActionPresenter"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
