<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameSaves.App.ViewModels"
             xmlns:models="using:GameSaves.App.Models"
             xmlns:views="using:GameSaves.App.Views"
             xmlns:wsp="using:GameSaves.App.Views.Workspace"
             x:Class="GameSaves.App.Views.BackupHistoryView"
             x:DataType="vm:BackupHistoryViewModel"
             Background="Transparent">


    <!-- The run list docks left and everything about the selected run stacks
         in the centre: the same split the fixed grid used, but now movable.
         The surface owns the splitter, so the page no longer declares one. -->
    <wsp:WorkspaceSurface Layout="{Binding Workspace}"
                          MaxWidth="1100"
                          Margin="0,12,24,14">
        <wsp:WorkspaceSurface.Panels>

            <wsp:WorkspacePanel PanelKey="backups.header"
                                Classes="pageHeader"
                                Title="Backups"
                                Subtitle="Restore points for your save files."
                                CanHide="False"
                                MinPanelWidth="320">
                <wsp:WorkspacePanel.HeaderActions>
                    <Button Content="Refresh"
                            Command="{Binding RefreshRunsCommand}"
                            VerticalAlignment="Center" />
                </wsp:WorkspacePanel.HeaderActions>

                <!-- With no runs there is nothing to select, so every pane below
                     hides and the empty state runs the full width of the page
                     here in the top band — the single "No backups yet" card the
                     page had before the split existed. -->
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <views:EmptyState Glyph="&#xE8F1;"
                                      Title="No backups yet"
                                      Message="Backups are created automatically before files are overwritten, or on demand from the Manual backup section."
                                      IsVisible="{Binding !Runs.Count}">
                        <views:EmptyState.ActionContent>
                            <Button Content="Create a backup"
                                    Classes="primary"
                                    Click="OnCreateBackupClick" />
                        </views:EmptyState.ActionContent>
                    </views:EmptyState>
                </StackPanel>
            </wsp:WorkspacePanel>

            <!-- Baseline left pane: 240 wide at minimum, never past 620, so the
                 run list stays a list and the detail column keeps the page. -->
            <wsp:WorkspacePanel PanelKey="backups.runs"
                                Title="Backup runs"
                                SizeMode="Fill"
                                CanHide="False"
                                IsVisible="{Binding !!Runs.Count}"
                                MinPanelWidth="240"
                                MaxPanelWidth="620">
                <Grid RowDefinitions="*,Auto">
                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Pagination.CurrentPageItems}"
                             SelectedItem="{Binding SelectedRun}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:BackupRunRowViewModel">
                            <StackPanel Spacing="3"
                                        Margin="4">

                                <TextBlock Text="{Binding GameName}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" />

                                <TextBlock Text="{Binding StartedDisplay}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}" />

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBlock Text="{Binding KindText}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="{DynamicResource FontSizeBody}" />

                                    <TextBlock Text="{Binding FileCount, StringFormat='{}{0} file(s)'}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}" />

                                    <TextBlock Text="{Binding TotalSizeDisplay}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource FontSizeBody}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding FormatDisplay}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="{DynamicResource FontSizeMicro}" />
                                    </Border>

                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            ToolTip.Tip="{Binding VerificationDetail}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding VerificationGlyph}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeMicro}" />
                                            <TextBlock Text="{Binding VerificationDisplay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeMicro}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding ProfilesDisplay}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource FontSizeBody}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>

                    <views:PaginationBar Grid.Row="1"
                                         DataContext="{Binding Pagination}" />
                </Grid>
            </wsp:WorkspacePanel>

            <wsp:WorkspacePanel PanelKey="backups.restore"
                                IsVisible="{Binding !!Runs.Count}"
                                Title="Restore"
                                Subtitle="Restore copies backup files to the target you choose below. Nothing is deleted. Files whose current version differs are only replaced when overwrite is enabled, and every replaced file is backed up first.">
                <Panel>
                    <views:EmptyState Glyph="&#xE777;"
                                      Title="Nothing selected to restore"
                                      Message="Select a backup run to configure a restore."
                                      IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNull}}" />

                    <StackPanel Spacing="6"
                                IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNotNull}}"
                                IsEnabled="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="Select a backup run to enable restore."
                                   IsVisible="{Binding SelectedRun, Converter={x:Static ObjectConverters.IsNull}}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding SelectedRun.ListDisplay, StringFormat='Selected run: {0}'}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Restore target"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />

                        <RadioButton Content="Restore to Original Location"
                                     GroupName="RestoreTarget"
                                     IsChecked="{Binding RestoreToOriginal}"
                                     FontSize="{DynamicResource FontSizeBody}"
                                     ToolTip.Tip="Copies each backup file back to the exact path recorded in the backup manifest." />

                        <RadioButton Content="Restore to Selected Profile"
                                     GroupName="RestoreTarget"
                                     IsChecked="{Binding RestoreToSelectedProfile}"
                                     FontSize="{DynamicResource FontSizeBody}"
                                     ToolTip.Tip="Redirects files from the backup's Steam userdata game folder into the selected profile's userdata folder for the same game. Files outside a userdata game folder are skipped." />

                        <StackPanel Spacing="4"
                                    IsVisible="{Binding RestoreToSelectedProfile}">
                            <TextBlock Text="Target profile"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}" />

                            <ComboBox ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedTargetProfile}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <RadioButton Content="Restore to Approved Mapping Location"
                                     GroupName="RestoreTarget"
                                     IsChecked="{Binding RestoreToMappingLocation}"
                                     FontSize="{DynamicResource FontSizeBody}"
                                     ToolTip.Tip="Copies the backup into a save location resolved from the approved mapping database (gamesave.db) for this game. Only approved, enabled mappings that resolve to exactly one path can be used." />

                        <StackPanel Spacing="4"
                                    IsVisible="{Binding RestoreToMappingLocation}">
                            <TextBlock Text="Mapping"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}" />

                            <ComboBox ItemsSource="{Binding MappingOptions}"
                                      SelectedItem="{Binding SelectedMappingOption}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <TextBlock Text="{Binding ResolvedTargetDisplay}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap" />

                        <CheckBox Content="Overwrite current files that differ from the backup"
                                  IsChecked="{Binding OverwriteCurrentFiles}" />

                        <CheckBox Content="I understand this will copy backup files to the selected target"
                                  IsChecked="{Binding ConfirmRestore}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10">
                            <Button Content="Preview restore"
                                    Command="{Binding PreviewRestoreCommand}" />

                            <Button Content="Restore to target"
                                    Command="{Binding ExecuteRestoreCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding RestoreStatusMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="16"
                                    IsVisible="{Binding !!RestoreResults.Count}">
                            <TextBlock Text="{Binding FilesRestored, StringFormat='Restored: {0} file(s)'}"
                                       Foreground="{DynamicResource SuccessBrush}" />

                            <TextBlock Text="{Binding FilesSkipped, StringFormat='Skipped: {0} file(s)'}"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <TextBlock Text="{Binding BytesRestoredDisplay, StringFormat='Bytes restored: {0}'}"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <TextBlock Text="{Binding FilesBackedUp, StringFormat='Backed up first: {0} file(s)'}"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding PreRestoreBackupMessage}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Panel>
            </wsp:WorkspacePanel>

            <!-- The file list is a content-height panel like the rest of the
                 centre stack: it grows with the run's files and the page
                 scrolls. Only the run list on the left fills its region. -->
            <wsp:WorkspacePanel PanelKey="backups.files"
                                Classes="table"
                                IsVisible="{Binding !!Runs.Count}"
                                Title="Files in this backup run"
                                MinPanelHeight="160">
                <wsp:WorkspacePanel.HeaderActions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="View hierarchy"
                                Command="{Binding ToggleFileViewModeCommand}"
                                IsVisible="{Binding !IsFileTreeMode}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Switch to expandable directory tree with deferred loading." />

                        <Button Content="View table"
                                Command="{Binding ToggleFileViewModeCommand}"
                                IsVisible="{Binding IsFileTreeMode}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Switch to flat table with sorting and hashes." />

                        <Button Content="Expand all"
                                Command="{Binding ExpandAllTreeNodesCommand}"
                                IsVisible="{Binding IsFileTreeMode}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Expand all directories in the tree." />

                        <Button Content="Collapse all"
                                Command="{Binding CollapseAllTreeNodesCommand}"
                                IsVisible="{Binding IsFileTreeMode}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Collapse all directories back to top-level roots." />

                        <Button Content="Verify payload integrity"
                                Command="{Binding VerifySelectedRunCommand}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Reads all payload files in this backup run and verifies them byte-for-byte against their SHA-256 hashes." />
                    </StackPanel>
                </wsp:WorkspacePanel.HeaderActions>
                <Grid RowDefinitions="Auto,*">

                    <TextBlock Grid.Row="0"
                               Text="{Binding FileListStatusMessage}"
                               IsVisible="{Binding !!FileListStatusMessage.Length}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Margin="10,4,10,6"
                               TextWrapping="Wrap" />

                    <views:EmptyState Grid.Row="1"
                                      Glyph="&#xE7C3;"
                                      Title="No files to show"
                                      Message="Select a backup run to see the files it contains."
                                      IsVisible="{Binding !RunItems.Count}" />

                    <!-- Flat Table View with Virtualized DataGrid -->
                    <DataGrid x:Name="BackupFilesGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding RunItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowHeight="38"
                              Background="Transparent"
                              BorderThickness="0"
                              AutomationProperties.Name="Backup files table">
                        <DataGrid.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!!RunItems.Count" />
                                <Binding Path="!IsFileTreeMode" />
                            </MultiBinding>
                        </DataGrid.IsVisible>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Original location" Width="2*" SortMemberPath="OriginalFile">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BackupItemRowViewModel">
                                        <TextBlock Text="{Binding OriginalFile}"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding BackupFile}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Size" Width="90" SortMemberPath="Item.Bytes">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BackupItemRowViewModel">
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SHA-256" Width="120" SortMemberPath="Sha256">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BackupItemRowViewModel">
                                        <TextBlock Text="{Binding Sha256Short}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   ToolTip.Tip="{Binding Sha256}"
                                                   FontFamily="Consolas,monospace"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="StatusDisplay">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BackupItemRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding StatusGlyph}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Hierarchical Tree View with Virtualized DataGrid and Deferred Expansion -->
                    <DataGrid x:Name="BackupTreeGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding FileTree.VisibleRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowHeight="38"
                              Background="Transparent"
                              BorderThickness="0"
                              AutomationProperties.Name="Backup file hierarchy tree">
                        <DataGrid.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!!RunItems.Count" />
                                <Binding Path="IsFileTreeMode" />
                            </MultiBinding>
                        </DataGrid.IsVisible>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="File hierarchy" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:SaveFileTreeNodeViewModel">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="{Binding IndentMargin}"
                                                    VerticalAlignment="Center">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="2,0"
                                                    MinWidth="24"
                                                    MinHeight="24"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsDirectory}"
                                                    Command="{Binding $parent[DataGrid].((vm:BackupHistoryViewModel)DataContext).ToggleTreeNodeCommand}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Expand or collapse {0}'}"
                                                    ToolTip.Tip="Expand or collapse folder">
                                                <TextBlock Text="{Binding ExpanderGlyph}"
                                                           FontFamily="Consolas,monospace"
                                                           FontSize="{DynamicResource FontSizeMicro}"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Button>
                                            <TextBlock Text="   "
                                                       FontFamily="Consolas,monospace"
                                                       IsVisible="{Binding IsFile}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TypeGlyph}"
                                                       Margin="2,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}"
                                                       ToolTip.Tip="{Binding RelativePath}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Size" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:SaveFileTreeNodeViewModel">
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Details / SHA-256" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:SaveFileTreeNodeViewModel">
                                        <Panel Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileCountDisplay}"
                                                       IsVisible="{Binding IsDirectory}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Sha256Short}"
                                                       IsVisible="{Binding IsFile}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       ToolTip.Tip="{Binding Sha256}"
                                                       FontFamily="Consolas,monospace" />
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:SaveFileTreeNodeViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding StatusGlyph}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </wsp:WorkspacePanel>

            <wsp:WorkspacePanel PanelKey="backups.restoreResults"
                                Classes="table"
                                IsVisible="{Binding !!Runs.Count}"
                                Title="Restore results"
                                Subtitle="Exactly what was restored, skipped, or failed during the last restore or preview.">
                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding !!RestoreResults.Count}">

                        <Grid ColumnDefinitions="2*,90,170,*"
                              ColumnSpacing="12">

                            <TextBlock Grid.Column="0"
                                       Text="Restore to"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="1"
                                       Text="Size"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="2"
                                       Text="Status"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="Bold" />

                            <TextBlock Grid.Column="3"
                                       Text="Details"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <views:EmptyState Grid.Row="1"
                                      Glyph="&#xE7A7;"
                                      Title="No restore results yet"
                                      Message="Run a restore preview to see exactly what would change."
                                      IsVisible="{Binding !RestoreResults.Count}" />

                    <ListBox Grid.Row="1"
                             Classes="virtualizedTable"
                             ItemsSource="{Binding RestoreResults}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Restore results list">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:BackupRestoreItemResultRowViewModel">
                                <Border Padding="12"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1">

                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="2*,90,170,*"
                                              ColumnSpacing="12">

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TargetFile}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       ToolTip.Tip="{Binding TargetFile}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Status}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Error}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       TextWrapping="Wrap" />
                                        </Grid>

                                        <TextBlock Text="{Binding PreRestoreBackupDisplay}"
                                                   IsVisible="{Binding HasPreRestoreBackup}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </wsp:WorkspacePanel>

            <wsp:WorkspacePanel PanelKey="backups.archive"
                                IsVisible="{Binding !!Runs.Count}"
                                Title="Archive (ZIP / 7-Zip)"
                                Subtitle="Export packs the selected run (files + manifest) into one archive for cold storage or another machine. Import brings an archive back into the backup base, where it appears in this list and can be restored. Nothing is ever overwritten.">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Format:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}" />
                            <ComboBox ItemsSource="{Binding AvailableFormats}"
                                      SelectedItem="{Binding SelectedExportFormat}"
                                      Width="120"
                                      ToolTip.Tip="Select the archive container format: standard ZIP or high-compression 7-Zip (.7z)." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsSevenZipSelected}">
                            <TextBlock Text="Preset:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="{DynamicResource FontSizeBody}" />
                            <ComboBox ItemsSource="{Binding AvailablePresets}"
                                      SelectedItem="{Binding SelectedCompressionPreset}"
                                      Width="120"
                                      ToolTip.Tip="Select compression level for 7-Zip (Store, Fast, Optimal, Ultra)." />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedRun.ListDisplay, StringFormat='Selected run: {0}', FallbackValue='No run selected.'}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <Button Content="Export Selected Run..."
                                Command="{Binding ExportSelectedRunCommand}"
                                ToolTip.Tip="Packs the selected run into an archive in a folder you choose. The run itself is not modified." />

                        <Button Content="Import Backup Archive..."
                                Command="{Binding ImportArchiveCommand}"
                                ToolTip.Tip="Extracts a previously exported backup archive (ZIP or 7-Zip) into the backup base and makes it restorable again." />
                    </StackPanel>

                    <TextBlock Text="{Binding ArchiveStatusMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </wsp:WorkspacePanel>

            <!-- Cleanup is the only delete in the app. The catalog owns the
                 title, so the heading's "deletes backup runs" qualifier lives in
                 the subtitle; the full warning stays in the content, where it
                 can keep warning ink that the muted subtitle cannot. -->
            <wsp:WorkspacePanel PanelKey="backups.cleanup"
                                IsVisible="{Binding !!Runs.Count}"
                                Title="Cleanup"
                                Subtitle="Deletes backup runs.">
                <StackPanel Spacing="6">
                    <TextBlock Text="This is the only place the app deletes anything. Only backup run folders inside the application backup base are deleted — save files and backups in custom destinations are never touched. Always preview first."
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Delete the selected run"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />

                    <TextBlock Text="{Binding SelectedRun.ListDisplay, StringFormat='Selected run: {0}', FallbackValue='No run selected.'}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <CheckBox Content="I understand this permanently deletes the selected backup run"
                              IsChecked="{Binding ConfirmDeleteRun}"
                              FontSize="{DynamicResource FontSizeBody}" />

                    <Button Content="Delete Selected Run"
                            Command="{Binding DeleteSelectedRunCommand}"
                            ToolTip.Tip="Permanently deletes the backup run selected in the list on the left. Save files are never touched." />

                    <TextBlock Text="Retention policy"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="Bold"
                               Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <TextBlock Text="Keep newest"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   VerticalAlignment="Center" />

                        <TextBox Text="{Binding KeepNewestRunsText}"
                                 Width="60" />

                        <TextBlock Text="run(s), delete the rest. Only runs older than"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   VerticalAlignment="Center" />

                        <TextBox Text="{Binding OlderThanDaysText}"
                                 PlaceholderText="any age"
                                 Width="70" />

                        <TextBlock Text="day(s)."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox Content="I understand this permanently deletes the previewed backup runs"
                              IsChecked="{Binding ConfirmCleanup}"
                              FontSize="{DynamicResource FontSizeBody}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <Button Content="Preview Cleanup (Dry Run)"
                                Command="{Binding PreviewCleanupCommand}" />

                        <Button Content="Delete Old Runs"
                                Command="{Binding ExecuteCleanupCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding CleanupStatusMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="{DynamicResource FontSizeBody}"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding CleanupResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BackupCleanupItemRowViewModel">
                                <Border Padding="10,6"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1">

                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="2*,90,120,*"
                                              ColumnSpacing="10">

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding RunDisplay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Status}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Error}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       TextWrapping="Wrap" />
                                        </Grid>

                                        <TextBlock Text="{Binding BackupRootPath}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource FontSizeMicro}"
                                                   ToolTip.Tip="{Binding BackupRootPath}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </wsp:WorkspacePanel>

        </wsp:WorkspaceSurface.Panels>
    </wsp:WorkspaceSurface>
</UserControl>
