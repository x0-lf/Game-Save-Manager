<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.76.0.4261" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="ValveKeyValue" Version="0.20.0.417" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameSaves.Core\GameSaves.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Profiles\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameSaves.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\curated-mappings.json" />
  </ItemGroup>

  <!-- OBS-027: the public Google Desktop OAuth client id baked into release
       builds, so users connect Google Drive without GAMESAVES_GOOGLE_CLIENT_ID.
       Empty in development and test builds; build/publish-release.ps1 passes
       -p:GoogleDesktopClientId=... from GSM_GOOGLE_DESKTOP_CLIENT_ID. A client
       id is public by Google's definition; the repository holds none, and the
       client secret never enters a build. -->
  <ItemGroup>
    <AssemblyMetadata Include="GoogleDesktopClientId" Value="$(GoogleDesktopClientId)" />
  </ItemGroup>

</Project>
